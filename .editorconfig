root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{md,ttl,yaml,yml,json}]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.csv]
trim_trailing_whitespace = false

# Source evidence must not be reformatted by an editor. Git owns the four
# explicitly documented legacy LF exceptions in .gitattributes.
[Baseball/data/raw/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
