  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-resolution/reach/{details.runner.id}/{details.playIndex}/{details.eventType}/{movement.end}" ; rr:termType rr:IRI ; rr:class base:RunnerResolutionProcess ; rr:class base:SafeProcess ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000062 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-act/reach/{details.runner.id}/{details.playIndex}/{details.eventType}/{movement.end}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000057 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{details.runner.id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000132 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001918 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/baseball-field" ; rr:termType rr:IRI ]
  ] .

<#RunnerReachRecordMap> a rr:TriplesMap ;
  rml:logicalSource <#RunnerReachSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-record/reach/{details.runner.id}/{details.playIndex}/{details.eventType}/{movement.end}" ; rr:termType rr:IRI ; rr:class base:BaseballEventRecord ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001808 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-resolution/reach/{details.runner.id}/{details.playIndex}/{details.eventType}/{movement.end}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "details.event" ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:identifier ;
    rr:objectMap [ rml:reference "details.eventType" ]
  ] .

