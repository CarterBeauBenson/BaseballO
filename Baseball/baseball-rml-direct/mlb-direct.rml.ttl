@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix base: <https://baseballontology.org/> .
@prefix data: <https://baseballontology.org/data/> .

# Direct mapping over an untouched MLB /feed/live JSON document.
# The source file name is intentionally stable; replace game.json with any downloaded completed game feed.

<#RootSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$" .

<#AwayTeamSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.teams.away" .

<#HomeTeamSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.teams.home" .

<#PlayerSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.players.*" .

<#VenueSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.venue" .

<#VenueCoordinateSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.venue.location.defaultCoordinates" .

<#PlaySource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*]" .

<#LastPlaySource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[-1:]" .

<#PitchSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true)]" .

<#BattedPitchSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.hitData)]" .

<#RunnerSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[*]" .

<#RunnerOutSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == true)]" .

<#RunnerScoreOriginSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @.movement.end == 'score' && @.movement.start == null)]" .

<#RunnerScoreBaseSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @.movement.end == 'score' && @.movement.start != null)]" .

<#RunnerReachSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @.movement.start == null && @.movement.end != 'score')]" .

<#RunnerAdvanceSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @.movement.start != null && @.movement.end != 'score')]" .

<#FieldingCreditSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[*].credits[*]" .

<#OfficialSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.boxscore.officials[*]" .

<#BallBSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'B')]" .

<#BallDirtSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == '*B')]" .

<#CalledStrikeSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'C')]" .

<#SwingingStrikeSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'S')]" .

<#FoulSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'F')]" .

<#FoulTipSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'T')]" .

<#InPlayOutSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'X')]" .

<#InPlayNoOutSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'D')]" .

<#InPlayRunsSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'E')]" .

<#Result_home_run_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'home_run')]" .

<#Result_field_out_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'field_out')]" .

<#Result_double_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'double')]" .

<#Result_walk_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'walk')]" .

<#Result_force_out_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'force_out')]" .

<#Result_strikeout_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'strikeout')]" .

<#Result_single_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'single')]" .

<#Result_grounded_into_double_play_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'grounded_into_double_play')]" .

<#Result_sac_fly_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'sac_fly')]" .

<#Result_double_play_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'double_play')]" .

<#Result_fielders_choice_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'fielders_choice')]" .

<#GameMap> a rr:TriplesMap ;
  rml:logicalSource <#RootSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ; rr:class base:BaseballGame ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001918 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/baseball-field" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000199 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/temporal-interval" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000057 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{$.gameData.teams.away.id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000057 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{$.gameData.teams.home.id}" ; rr:termType rr:IRI ]
  ] .

<#GameIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#RootSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/identifier/mlb-game-pk" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "gamePk" ; rr:datatype xsd:string ]
  ] .

<#AwayTeamMap> a rr:TriplesMap ;
  rml:logicalSource <#AwayTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ; rr:class base:BaseballTeam ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#AwayTeamIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#AwayTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}/identifier/mlb-team-id" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "id" ; rr:datatype xsd:string ]
  ] .

<#AwayTeamNameMap> a rr:TriplesMap ;
  rml:logicalSource <#AwayTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}/name/mlb-full" ; rr:termType rr:IRI ; rr:class cco:ont00001014 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#AwayTeamRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#AwayTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/team-role/away" ; rr:termType rr:IRI ; rr:class base:AwayTeamRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000054 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ]
  ] .

<#HomeTeamMap> a rr:TriplesMap ;
  rml:logicalSource <#HomeTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ; rr:class base:BaseballTeam ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#HomeTeamIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#HomeTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}/identifier/mlb-team-id" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "id" ; rr:datatype xsd:string ]
  ] .

<#HomeTeamNameMap> a rr:TriplesMap ;
  rml:logicalSource <#HomeTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}/name/mlb-full" ; rr:termType rr:IRI ; rr:class cco:ont00001014 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#HomeTeamRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#HomeTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/team-role/home" ; rr:termType rr:IRI ; rr:class base:HomeTeamRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000054 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ]
  ] .

<#VenueMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{id}" ; rr:termType rr:IRI ; rr:class base:BaseballVenue ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#VenueIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{id}/identifier/mlb-venue-id" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "id" ; rr:datatype xsd:string ]
  ] .

<#VenueNameMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{id}/name/mlb-full" ; rr:termType rr:IRI ; rr:class cco:ont00001014 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#BaseballFieldSiteMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{id}/baseball-field" ; rr:termType rr:IRI ; rr:class base:BaseballFieldSite ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000171 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{id}" ; rr:termType rr:IRI ]
  ] .

# Uses the project-approved coordinate ICE pattern for source latitude/longitude.
<#VenueCoordinateICEMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueCoordinateSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/coordinate/default" ; rr:termType rr:IRI ; rr:class base:BaseballFieldCoordinateICE ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001766 ;
    rr:objectMap [ rml:reference "latitude" ; rr:datatype xsd:decimal ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001764 ;
    rr:objectMap [ rml:reference "longitude" ; rr:datatype xsd:decimal ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001808 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/baseball-field" ; rr:termType rr:IRI ]
  ] .

<#PlayerMap> a rr:TriplesMap ;
  rml:logicalSource <#PlayerSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{id}" ; rr:termType rr:IRI ; rr:class cco:ont00001262 ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "fullName" ]
  ] .

<#PlayerIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#PlayerSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{id}/identifier/mlb-person-id" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "id" ; rr:datatype xsd:string ]
  ] .

<#PlayerNameMap> a rr:TriplesMap ;
  rml:logicalSource <#PlayerSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{id}/name/mlb-full" ; rr:termType rr:IRI ; rr:class cco:ont00001014 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "fullName" ]
  ] .

<#BatterRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{matchup.batter.id}/role/batter" ; rr:termType rr:IRI ; rr:class base:BatterRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{matchup.batter.id}" ; rr:termType rr:IRI ]
  ] .

<#PitcherRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{matchup.pitcher.id}/role/pitcher" ; rr:termType rr:IRI ; rr:class base:PitcherRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{matchup.pitcher.id}" ; rr:termType rr:IRI ]
  ] .

<#BaserunnerRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#RunnerSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{details.runner.id}/role/baserunner" ; rr:termType rr:IRI ; rr:class base:BaserunnerRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{details.runner.id}" ; rr:termType rr:IRI ]
  ] .

<#FielderRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#FieldingCreditSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{player.id}/role/fielder" ; rr:termType rr:IRI ; rr:class base:FielderRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{player.id}" ; rr:termType rr:IRI ]
  ] .

<#BatterPersonFromPlayMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{matchup.batter.id}" ; rr:termType rr:IRI ] .

<#PitcherPersonFromPlayMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/player/{matchup.pitcher.id}" ; rr:termType rr:IRI ] .

<#UmpirePersonMap> a rr:TriplesMap ;
  rml:logicalSource <#OfficialSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/person/{official.id}" ; rr:termType rr:IRI ; rr:class cco:ont00001262 ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "official.fullName" ]
  ] .

<#UmpireRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#OfficialSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/person/{official.id}/role/umpire" ; rr:termType rr:IRI ; rr:class base:UmpireRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/person/{official.id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000054 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ]
  ] .

