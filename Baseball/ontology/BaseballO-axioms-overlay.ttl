@prefix base: <https://baseballontology.org/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix cpo: <http://www.ontologyrepository.com/CommonCoreOntologies/> .
@prefix mro: <https://www.commoncoreontologies.org/mro/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://baseballontology.org/baseball-event-ontology-axioms-overlay>
    a owl:Ontology ;
    owl:versionIRI <https://baseballontology.org/2026-09-01/baseball-event-ontology-axioms-overlay> ;
    owl:versionInfo "0.7.1"@en ;
    owl:imports
        <https://baseballontology.org/baseball-event-ontology> ,
        <http://www.ontologyrepository.com/CommonCoreOntologies/Domain/CognitiveProcessOntology> ,
        <https://www.commoncoreontologies.org/ModalRelationOntology> ;
    dcterms:title "Baseball Event and Adjudication Ontology Axiom Overlay"@en ;
    dcterms:created "2026-07-30"^^xsd:date ;
    dcterms:modified "2026-09-01"^^xsd:date ;
    rdfs:comment "Optional logical axioms for the Baseball Event and Adjudication Ontology. Load this ontology with BaseballO to enable the restrictions below; omit it to use only BaseballO's annotated taxonomic backbone."@en ;
    rdfs:comment "All class and object-property IRIs used by this overlay are declared in, or referenced by, the ontology files stored in this repository. The overlay intentionally states only necessary conditions when the complete natural-language differentia cannot be represented without new vocabulary."@en .


#################################################################
# Core game processes
#################################################################

base:BaseballGame
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:BaseballRule ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:BaseballAct ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:BaseballPhysicalProcess ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:BaseballInstitutionalProcess ] .

base:BaseballSeason rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:BaseballRule ],
    [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:BaseballGame ] .

base:BaseballSeasonPhase rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty obo:BFO_0000132 ; owl:someValuesFrom base:BaseballSeason ],
    [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:BaseballGame ] .

base:BaseballSeasonPlan rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty cco:ont00001942 ; owl:someValuesFrom base:BaseballSeason ],
    [ a owl:Restriction ; owl:onProperty cco:ont00001942 ; owl:someValuesFrom base:BaseballSeasonPhase ] .

base:BaseballGameSchedulePlan
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty cco:ont00001942 ;
          owl:someValuesFrom base:BaseballGame
        ] ,
        [ a owl:Restriction ;
          owl:onProperty obo:BFO_0000178 ;
          owl:someValuesFrom [
              a owl:Class ;
              owl:intersectionOf (
                  cco:ont00000073
                  [ a owl:Restriction ;
                    owl:onProperty cco:ont00001916 ;
                    owl:someValuesFrom obo:BFO_0000038
                  ]
              )
          ]
        ] .

base:BaseballGamePostponementAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001833 ; owl:someValuesFrom cco:ont00001017 ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:BaseballGameSchedulePlan ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:BaseballGameSchedulePlan ] .

base:Inning
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000132 ; owl:someValuesFrom base:BaseballGame ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:HalfInning ] .

base:HalfInning
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000132 ; owl:someValuesFrom base:Inning ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:BaseballTeam ] .

base:PlateAppearance
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000132 ; owl:someValuesFrom base:HalfInning ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom cco:ont00001262 ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:BatterAct ] .

base:BaserunnerAtBaseStasis
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom [ a owl:Class ; owl:intersectionOf ( cco:ont00001262 [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom base:BaserunnerRole ] ) ] ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Base ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:BaseSite ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000199 ; owl:someValuesFrom obo:BFO_0000038 ],
        [ a owl:Restriction ; owl:onProperty cco:ont00001918 ; owl:someValuesFrom base:BaseSite ] .

cco:ont00000819
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty obo:BFO_0000055 ;
          owl:maxCardinality "0"^^xsd:nonNegativeInteger
        ] .

base:PlateAppearanceStartOutCountICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:PlateAppearance ] .

base:BattedBallPlayProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:BatBallContactProcess ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:BattedBallMotionProcess ] .


#################################################################
# Artifacts and sites
#################################################################

base:Baseball
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mro:BFO_0000056 ; owl:someValuesFrom base:BaseballGame ] .

base:BaseballBat
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mro:BFO_0000056 ; owl:someValuesFrom base:BatUseAct ] .

base:Base
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mro:BFO_0000056 ; owl:someValuesFrom base:BaserunningAct ] .

base:BaseSite
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000176 ; owl:someValuesFrom base:BaseballFieldSite ] .

base:BaseballFieldSite
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty mro:BFO_0000183 ; owl:someValuesFrom base:BaseballGame ] .

base:FairTerritorySite
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000176 ; owl:someValuesFrom base:BaseballFieldSite ] .

base:FoulTerritorySite
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000176 ; owl:someValuesFrom base:BaseballFieldSite ] .

#################################################################
# Roles
#################################################################

base:PlayerRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:BaseballGame ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000056 ; owl:someValuesFrom cco:ont00000824 ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001992 ; owl:someValuesFrom base:BaseballTeam ] .

base:BatterRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:BatterAct ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000056 ; owl:someValuesFrom cco:ont00000824 ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000197 ; owl:someValuesFrom cco:ont00001262 ] .

base:PitcherRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:PitcherAct ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000056 ; owl:someValuesFrom cco:ont00000824 ] .

base:FielderRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:FielderAct ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000056 ; owl:someValuesFrom cco:ont00000824 ] .

base:BaserunnerRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:BaserunnerAct ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000056 ; owl:someValuesFrom cco:ont00000824 ] .

base:ManagerRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:BaseballGame ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000056 ; owl:someValuesFrom cco:ont00000824 ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001992 ; owl:someValuesFrom base:BaseballTeam ] .

base:BaseballAdjudicatorRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000197 ; owl:someValuesFrom cco:ont00001017 ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:BaseballAdjudicationAct ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000056 ; owl:someValuesFrom cco:ont00000824 ] .

base:UmpireRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:UmpireJudgmentAct ] .

base:OfficialScorerRole
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:ScorerJudgmentAct ] .


#################################################################
# Intentional baseball acts
#################################################################

base:BaseballAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000132 ; owl:someValuesFrom base:BaseballGame ] .

base:PlayerAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:PlayerRole ] .

base:BatterAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:BatterRole ] .

base:BatUseAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:BaseballBat ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:SwingAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:BaseballBat ] .

base:BuntAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:BaseballBat ] .

base:PitcherAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:PitcherRole ] .

base:PitchAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:PitchRule ] .

base:FielderAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:FielderRole ] .

base:FieldingAttemptAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:CatchAttemptAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:ThrowAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:TagAttemptAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:BaserunnerAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:BaserunnerRole ] .

base:BaserunningAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Base ] .

base:ManagerAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:ManagerRole ] .

base:SubstitutionAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001778 ; owl:someValuesFrom base:PlayerRole ] .

base:ChallengeAct
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf (
            base:BaseballAct
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:BaseballJudgmentAct ]
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000063 ; owl:someValuesFrom base:BaseballReplayReviewAct ]
        )
    ] .

base:ManagerChallengeAct
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( base:ChallengeAct base:ManagerAct )
    ] .

base:PlayerChallengeAct
    owl:equivalentClass [ a owl:Class ;
        owl:intersectionOf ( base:ChallengeAct base:PlayerAct )
    ] .

base:BaseballAdjudicationAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:BaseballAdjudicatorRole ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:BaseballDecisionICE ] .


#################################################################
# Physical baseball processes
#################################################################

base:BaseballPhysicalProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000132 ; owl:someValuesFrom base:BaseballGame ] .

base:PitchBallMotionProcess
    rdfs:subClassOf
        [ a owl:Class ; owl:intersectionOf (
            cco:ont00001133
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:PitchAct ]
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ]
        ) ] .

base:BatBallContactProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:BatUseAct ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:BaseballBat ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:BattedBallMotionProcess
    rdfs:subClassOf
        [ a owl:Class ; owl:intersectionOf (
            cco:ont00001133
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:BatBallContactProcess ]
            [ a owl:Restriction ; owl:onProperty cco:ont00001819 ; owl:someValuesFrom base:BatBallContactProcess ]
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ]
        ) ] .

base:ThrownBallMotionProcess
    rdfs:subClassOf
        [ a owl:Class ; owl:intersectionOf (
            cco:ont00001133
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:ThrowAct ]
            [ a owl:Restriction ; owl:onProperty cco:ont00001819 ; owl:someValuesFrom base:ThrowAct ]
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ]
        ) ] .

base:BallDeflectionProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:BallCatchingProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:BallControlProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:BallControlFailureProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:PitchBallControlFailureProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:PitchBallMotionProcess ] .

base:TaggingProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .

base:BaseTouchingProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Base ] .

base:BallBoundaryCrossingProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom base:Baseball ] .


#################################################################
# Decision information content entities
#################################################################

base:BaseballDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:BaseballAdjudicationAct ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:BaseballRule ] .

base:BallDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:BallJudgmentAct ] .

base:StrikeDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:StrikeJudgmentAct ] .

base:FairDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:FairBallJudgmentAct ] .

base:FoulDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:FoulBallJudgmentAct ] .

base:OutDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:OutJudgmentAct ] .

base:SafeDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:SafeJudgmentAct ] .

base:HitDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:HitJudgmentAct ] .

base:ErrorDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:ErrorJudgmentAct ] .

base:FieldersChoiceDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:FieldersChoiceJudgmentAct ] .

base:SacrificeDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:SacrificeJudgmentAct ] .

base:PassedBallDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:PassedBallJudgmentAct ] .

base:WildPitchDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:WildPitchJudgmentAct ] .

base:RunDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:RunJudgmentAct ] .

base:StolenBaseDecisionICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:StolenBaseJudgmentAct ] .

base:BaseballEventRecord
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001982 ; owl:someValuesFrom base:BaseballInstitutionalProcess ] .


#################################################################
# Judgment acts
#################################################################

base:BaseballJudgmentAct
    rdfs:subClassOf cpo:ActOfJudging .

base:UmpireJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:UmpireRole ] .

base:ScorerJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000055 ; owl:someValuesFrom base:OfficialScorerRole ] .

base:PitchJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:PitchRule ] .

base:BallJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:BallDecisionICE ] .

base:StrikeJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:StrikeDecisionICE ] .

base:FairFoulJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:FairFoulRule ] .

base:FairBallJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:FairDecisionICE ] .

base:FoulBallJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:FoulDecisionICE ] .

base:OutSafeJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty cco:ont00001920 ;
          owl:someValuesFrom [ a owl:Class ; owl:unionOf ( base:OutRule base:SafeRule ) ]
        ] .

base:OutJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:OutDecisionICE ] .

base:SafeJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:SafeDecisionICE ] .

base:ScoringJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:BaseballRule ] .

base:HitJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:HitDecisionICE ] .

base:ErrorJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:ErrorDecisionICE ] .

base:FieldersChoiceJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:FieldersChoiceDecisionICE ] .

base:SacrificeJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:SacrificeDecisionICE ] .

base:PassedBallJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:PassedBallDecisionICE ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:PassedBallRule ] .

base:WildPitchJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:WildPitchDecisionICE ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:WildPitchRule ] .

base:RunJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:RunDecisionICE ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:RunRule ] .

base:StolenBaseJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:StolenBaseDecisionICE ] .


#################################################################
# Public call acts
#################################################################

base:BaseballCallAct
