            [ a owl:Class ; owl:intersectionOf (
                obo:BFO_0000015
                [ a owl:Restriction ; owl:onProperty obo:BFO_0000132 ; owl:someValuesFrom base:BattedBallMotionProcess ]
            ) ]
        ] .

base:AngleQuality rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty obo:BFO_0000197 ;
      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
      owl:onClass obo:BFO_0000142
    ] .

base:DistanceQuality rdfs:subClassOf
    [ a owl:Restriction ;
      owl:onProperty obo:BFO_0000197 ;
      owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ;
      owl:onClass obo:BFO_0000147
    ] .

# These axioms use Fiat Lines, a Fiat Point, and an Angle Quality; they do not
# use Spatial Region or Coordinate System Axis classes. No provider-coordinate
# execution axiom is proposed. Provider origin, orientation, sign, scale,
# projection, polygon, literal properties, and missing-value behavior must be
# approved before a source-specific mapping uses these classes.


#################################################################
# Compound and specialized play patterns
#################################################################

base:DoublePlayProcess
    rdfs:subClassOf
        [ a owl:Restriction ;
          owl:onProperty cco:ont00001777 ;
          owl:qualifiedCardinality "2"^^xsd:nonNegativeInteger ;
          owl:onClass base:OutProcess
        ] .

base:FoulTipJudgmentAct
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:BatBallContactProcess ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:BallCatchingProcess ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:StrikeRule ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:FoulTipCallICE ] .

base:FoulTipProcess
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom base:FoulTipJudgmentAct ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:BatBallContactProcess ] ,
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:BallCatchingProcess ] .

base:FoulTipCallICE
    rdfs:subClassOf
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:FoulTipJudgmentAct ] ,
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:FoulTipProcess ] .

base:BaseballPersonnelTradeAct rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty cco:ont00001833 ; owl:minQualifiedCardinality "2"^^xsd:nonNegativeInteger ; owl:onClass base:BaseballTeam ],
    [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom
        [ a owl:Class ; owl:intersectionOf (
            cco:ont00000613
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom
                [ a owl:Class ; owl:intersectionOf (
                    cco:ont00001262
                    [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom
                        [ a owl:Class ; owl:intersectionOf (
                            cco:ont00000984
                            [ a owl:Restriction ; owl:onProperty cco:ont00001992 ; owl:someValuesFrom base:BaseballTeam ]
                        ) ]
                    ]
                ) ]
            ]
        ) ]
    ],
    [ a owl:Restriction ; owl:onProperty obo:BFO_0000117 ; owl:someValuesFrom
        [ a owl:Class ; owl:intersectionOf (
            cco:ont00001194
            [ a owl:Restriction ; owl:onProperty obo:BFO_0000057 ; owl:someValuesFrom
                [ a owl:Class ; owl:intersectionOf (
                    cco:ont00001262
                    [ a owl:Restriction ; owl:onProperty obo:BFO_0000196 ; owl:someValuesFrom
                        [ a owl:Class ; owl:intersectionOf (
                            cco:ont00000984
                            [ a owl:Restriction ; owl:onProperty cco:ont00001992 ; owl:someValuesFrom base:BaseballTeam ]
                        ) ]
                    ]
                ) ]
            ]
        ) ]
    ] .

base:UniformNumberAssignmentAct rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty cco:ont00001833 ; owl:someValuesFrom base:BaseballTeam ],
    [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom
        [ a owl:Class ; owl:intersectionOf (
            cco:ont00000077
            [ a owl:Restriction ; owl:onProperty cco:ont00001916 ; owl:someValuesFrom
                [ a owl:Class ; owl:intersectionOf (
                    base:PlayerRole
                    [ a owl:Restriction ; owl:onProperty cco:ont00001992 ; owl:someValuesFrom base:BaseballTeam ]
                ) ]
            ]
        ) ]
    ] .


#################################################################
# Replay-review adjudication pattern
#################################################################

base:BaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BaseballAdjudicationAct
        [ a owl:Restriction ;
          owl:onProperty cco:ont00001921 ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass base:BaseballDecisionICE ]
        [ a owl:Restriction ;
          owl:onProperty cco:ont00001986 ;
          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
          owl:onClass base:BaseballDecisionICE ]
    ) ] .

base:ReviewedOnFieldBaseballDecisionICE
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BaseballDecisionICE
        [ a owl:Restriction ; owl:onProperty cco:ont00001841 ; owl:someValuesFrom base:BaseballReplayReviewAct ]
    ) ] .

base:BaseballReplayDecisionICE
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BaseballDecisionICE
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:BaseballReplayReviewAct ]
    ) ] .

base:ReviewedOnFieldUmpireJudgmentAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:UmpireJudgmentAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:ReviewedOnFieldBaseballDecisionICE ]
    ) ] .

base:BaseballReplayOfficialRole
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BaseballAdjudicatorRole
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000054 ; owl:someValuesFrom base:BaseballReplayReviewAct ]
    ) ] .

base:ChallengedBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty obo:BFO_0000062 ; owl:someValuesFrom base:ChallengeAct ]
    ) ] .


#################################################################
# Affirming replay-review transitions
#################################################################

base:BallAffirmingBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BallJudgmentAct
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:BallDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:BallDecisionICE ]
    ) ] .

base:StrikeAffirmingBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:StrikeJudgmentAct
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:StrikeDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:StrikeDecisionICE ]
    ) ] .

base:OutAffirmingBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:OutJudgmentAct
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:OutDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:OutDecisionICE ]
    ) ] .

base:SafeAffirmingBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:SafeJudgmentAct
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:SafeDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:SafeDecisionICE ]
    ) ] .

base:AffirmingBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:unionOf (
        base:BallAffirmingBaseballReplayReviewAct
        base:StrikeAffirmingBaseballReplayReviewAct
        base:OutAffirmingBaseballReplayReviewAct
        base:SafeAffirmingBaseballReplayReviewAct
    ) ] .


#################################################################
# Overturning replay-review transitions
#################################################################

base:BallToStrikeBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:StrikeJudgmentAct
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:BallDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:StrikeDecisionICE ]
    ) ] .

base:StrikeToBallBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BallJudgmentAct
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:StrikeDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:BallDecisionICE ]
    ) ] .

base:OutToSafeBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:SafeJudgmentAct
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:OutDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:SafeDecisionICE ]
    ) ] .

base:SafeToOutBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:OutJudgmentAct
        base:BaseballReplayReviewAct
        [ a owl:Restriction ; owl:onProperty cco:ont00001921 ; owl:someValuesFrom base:SafeDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001986 ; owl:someValuesFrom base:OutDecisionICE ]
    ) ] .

base:OverturningBaseballReplayReviewAct
    owl:equivalentClass [ a owl:Class ; owl:unionOf (
        base:BallToStrikeBaseballReplayReviewAct
        base:StrikeToBallBaseballReplayReviewAct
        base:OutToSafeBaseballReplayReviewAct
        base:SafeToOutBaseballReplayReviewAct
    ) ] .


#################################################################
# Replay-review result information and records
#################################################################

base:BaseballReplayReviewDispositionICE
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        cco:ont00000853
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:BaseballReplayReviewAct ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:ReviewedOnFieldBaseballDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:BaseballReplayDecisionICE ]
    ) ] .

base:AffirmingBaseballReplayReviewDispositionICE
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BaseballReplayReviewDispositionICE
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:AffirmingBaseballReplayReviewAct ]
    ) ] .

base:OverturningBaseballReplayReviewDispositionICE
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BaseballReplayReviewDispositionICE
        [ a owl:Restriction ; owl:onProperty cco:ont00001816 ; owl:someValuesFrom base:OverturningBaseballReplayReviewAct ]
    ) ] .

base:BaseballReplayReviewEventRecord
    owl:equivalentClass [ a owl:Class ; owl:intersectionOf (
        base:BaseballEventRecord
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:BaseballReplayReviewAct ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:ReviewedOnFieldBaseballDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:BaseballReplayDecisionICE ]
        [ a owl:Restriction ; owl:onProperty cco:ont00001808 ; owl:someValuesFrom base:BaseballReplayReviewDispositionICE ]
    ) ] .

[] a owl:AllDisjointClasses ;
    owl:members (
        base:BallDecisionICE
        base:StrikeDecisionICE
        base:OutDecisionICE
        base:SafeDecisionICE
    ) .

base:AffirmingBaseballReplayReviewAct
    owl:disjointWith base:OverturningBaseballReplayReviewAct .

base:AffirmingBaseballReplayReviewDispositionICE
    owl:disjointWith base:OverturningBaseballReplayReviewDispositionICE .


#################################################################
# Accepted classification, season, transaction, and strike-zone axioms
#################################################################

base:BaseballSeasonSegment rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty obo:BFO_0000132 ; owl:someValuesFrom base:BaseballSeason ],
    [ a owl:Restriction ; owl:onProperty cco:ont00001920 ; owl:someValuesFrom base:BaseballSeasonPlan ] .

base:BaseballPreseasonPhase owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballSeasonPhase [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:PreseasonSegmentTypeICE ] ) ] .
base:BaseballRegularSeasonPhase owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballSeasonPhase [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:RegularSeasonSegmentTypeICE ] ) ] .
base:BaseballPostseasonPhase owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballSeasonPhase [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:PostseasonSegmentTypeICE ] ) ] .
base:BaseballAllStarPhase owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballSeasonPhase [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:AllStarSegmentTypeICE ] ) ] .
base:BaseballOffseasonSegment owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballSeasonSegment [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:OffseasonSegmentTypeICE ] ) ] .

base:BaseballTransactionPeriod rdfs:subClassOf
    [ a owl:Restriction ; owl:onProperty cco:ont00001801 ; owl:someValuesFrom base:BaseballRule ],
    [ a owl:Restriction ; owl:onProperty cco:ont00001879 ; owl:someValuesFrom cco:ont00000073 ] .

base:MajorLeagueFreeAgentQuietPeriod owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballTransactionPeriod [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:FreeAgentQuietPeriodTypeICE ] ) ] .
base:MajorLeagueOpenFreeAgencyPeriod owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballTransactionPeriod [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:OpenFreeAgencyPeriodTypeICE ] ) ] .
base:MajorLeagueSalaryArbitrationPeriod owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballTransactionPeriod [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:SalaryArbitrationPeriodTypeICE ] ) ] .
base:MajorLeagueInternationalSigningPeriod owl:equivalentClass [ a owl:Class ; owl:intersectionOf ( base:BaseballTransactionPeriod [ a owl:Restriction ; owl:onProperty cco:ont00001914 ; owl:hasValue base:InternationalSigningPeriodTypeICE ] ) ] .

base:MajorLeagueFreeAgentQuietPeriod rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty cco:ont00001971 ;
    owl:someValuesFrom [
        a owl:Class ;
        owl:intersectionOf (
            obo:BFO_0000202
            [ a owl:Restriction ; owl:onProperty cco:ont00001874 ; owl:someValuesFrom base:BaseballOffseasonSegment ]
        )
    ]
] .

