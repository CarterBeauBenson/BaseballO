  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-act/movement/{_baseballO.atBatIndex}/{_baseballO.runnerIndex}" ; rr:termType rr:IRI ; rr:class base:BaserunningAct ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000057 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{details.runner.id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000055 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/player/{details.runner.id}/role/baserunner" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000132 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{_baseballO.atBatIndex}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001918 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/baseball-field" ; rr:termType rr:IRI ]
  ] .

