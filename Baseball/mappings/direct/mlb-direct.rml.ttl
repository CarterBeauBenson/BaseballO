  rml:logicalSource <#BattedResultPlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/process/fair-ball/{_baseballO.terminalPitchPlayId}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000063 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/result" ; rr:termType rr:IRI ] ] .

