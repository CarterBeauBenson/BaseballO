# Every source-reported plate-appearance result receives its own constitutive
# adjudication act and decision ICE. More specific overlays below add the
# supported umpire/scorer judgment type, authority role, and rule input.
<#PlateAppearanceResultJudgmentMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/judgment/result" ; rr:termType rr:IRI ; rr:class base:BaseballAdjudicationAct ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000132 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/result" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001986 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/decision/result" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001918 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/baseball-field" ; rr:termType rr:IRI ]
  ] .

