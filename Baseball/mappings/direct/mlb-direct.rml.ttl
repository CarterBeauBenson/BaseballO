    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/pitch/{playId}/temporal-interval" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate dcterms:identifier ;
    rr:objectMap [ rml:reference "playId" ]
  ] .

