# Parent-level terminal-event maps avoid the selected processor's incomplete
# multi-value parent join when connecting an in-play pitch to its enclosing
# plate-appearance result.
<#TerminalBattedBallMotionResultSequenceMap> a rr:TriplesMap ;
  rml:logicalSource <#BattedResultPlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/process/batted-ball-motion/{_baseballO.terminalPitchPlayId}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000063 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/result" ; rr:termType rr:IRI ] ] .

