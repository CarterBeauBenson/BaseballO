@base <https://baseballontology.org/mapping/mlb-direct> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix base: <https://baseballontology.org/> .
@prefix data: <https://baseballontology.org/data/> .

# Direct mapping over an untouched MLB /feed/live JSON document plus an isolated
# execution-context copy generated from that same document. The raw game.json
# remains byte-identical; game-context.json only exposes ancestor identifiers to
# nested pitch records because RMLMapper cannot expand parent array references.
# Templates can contain explicit root-identifier markers for the game, venue, and
# participating teams. The execution harness resolves only those markers in a temporary
# mapping copy because nested JSONPath references are relative to their logical-source record.

<#RootSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$" .

<#AwayTeamSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.teams.away" .

<#HomeTeamSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.teams.home" .

<#PlayerSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.players.*" .

<#VenueSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.venue" .

<#PlaySource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*]" .

<#LastPlaySource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$" .

<#PitchSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true)]" .

<#BattedPitchSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'F' || @.isPitch == true && @.details.call.code == 'T' || @.isPitch == true && @.details.call.code == 'X' || @.isPitch == true && @.details.call.code == 'D' || @.isPitch == true && @.details.call.code == 'E')]" .

<#BattedCoordinateSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.hitData.coordinates)]" .

<#RunnerSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[*]" .

<#RunnerOutSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == true)]" .

<#RunnerScoreOriginSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @._baseballO.endsAtScore == true && @._baseballO.hasSupportedStartBase == false)]" .

<#RunnerScoreBaseSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @._baseballO.endsAtScore == true && @._baseballO.hasSupportedStartBase == true)]" .

<#RunnerReachSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @._baseballO.endsAtScore == false && @._baseballO.hasSupportedStartBase == false)]" .

<#RunnerAdvanceSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @._baseballO.endsAtScore == false && @._baseballO.hasSupportedStartBase == true)]" .

<#StolenBaseRunnerSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.details.eventType == 'stolen_base_2b' || @.details.eventType == 'stolen_base_3b' || @.details.eventType == 'stolen_base_home')]" .

<#CaughtStealingRunnerSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.details.eventType == 'caught_stealing_2b' || @.details.eventType == 'caught_stealing_3b' || @.details.eventType == 'caught_stealing_home')]" .

<#FieldingCreditSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[*].credits[*]" .

<#OfficialSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.boxscore.officials[*]" .

<#BallBSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'B')]" .

<#BallDirtSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == '*B')]" .

<#AllBallSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'B' || @.isPitch == true && @.details.call.code == '*B')]" .

<#CalledStrikeSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'C')]" .

<#SwingingStrikeSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'S')]" .

<#CalledOrSwingingStrikeSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'C' || @.isPitch == true && @.details.call.code == 'S')]" .

<#FoulSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'F')]" .

# The event-local feed cannot distinguish every second-strike foul from a
# two-strike foul. This conservative source emits only unambiguous first
# counted fouls; the remaining ambiguity is documented as a source gap.
<#CountedFoulSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'F' && @.count.strikes == 1)]" .

<#FoulTipSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'T')]" .

<#InPlayOutSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @._baseballO.plateAppearanceIsSacBunt == false && @.details.call.code == 'X')]" .

<#InPlayNoOutSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @._baseballO.plateAppearanceIsSacBunt == false && @.details.call.code == 'D')]" .

<#InPlayRunsSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @._baseballO.plateAppearanceIsSacBunt == false && @.details.call.code == 'E')]" .

<#BuntSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @._baseballO.plateAppearanceIsSacBunt == true && @.details.call.code == 'X' || @.isPitch == true && @._baseballO.plateAppearanceIsSacBunt == true && @.details.call.code == 'D' || @.isPitch == true && @._baseballO.plateAppearanceIsSacBunt == true && @.details.call.code == 'E')]" .

<#AllInPlaySource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'X' || @.isPitch == true && @.details.call.code == 'D' || @.isPitch == true && @.details.call.code == 'E')]" .

<#SwingBatSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'S' || @.isPitch == true && @.details.call.code == 'F' || @.isPitch == true && @.details.call.code == 'T' || @.isPitch == true && @.details.call.code == 'X' || @.isPitch == true && @.details.call.code == 'D' || @.isPitch == true && @.details.call.code == 'E')]" .

<#Result_home_run_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'home_run')]" .

<#Result_field_out_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'field_out')]" .

<#Result_double_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'double')]" .

<#Result_walk_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'walk' || @.result.eventType == 'intent_walk')]" .

<#Result_force_out_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'force_out')]" .

<#Result_strikeout_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'strikeout')]" .

<#Result_single_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'single')]" .

<#Result_grounded_into_double_play_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'grounded_into_double_play')]" .

<#Result_sac_fly_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'sac_fly')]" .

<#Result_double_play_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'double_play')]" .

<#Result_fielders_choice_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'fielders_choice' || @.result.eventType == 'fielders_choice_out')]" .

<#Result_triple_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'triple')]" .

<#Result_sac_bunt_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'sac_bunt')]" .

<#Result_field_error_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'field_error')]" .

<#Result_hit_by_pitch_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'hit_by_pitch')]" .

<#Result_balk_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'balk')]" .

<#Result_interference_Source> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'catcher_interf')]" .

<#ScoredHitResultSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'single' || @.result.eventType == 'double' || @.result.eventType == 'triple' || @.result.eventType == 'home_run')]" .

<#SacrificeResultSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'sac_fly' || @.result.eventType == 'sac_bunt')]" .

<#OutResultSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'field_out' || @.result.eventType == 'force_out' || @.result.eventType == 'strikeout' || @.result.eventType == 'double_play' || @.result.eventType == 'grounded_into_double_play')]" .

<#BattedResultPlaySource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@.result.eventType == 'single' || @.result.eventType == 'double' || @.result.eventType == 'triple' || @.result.eventType == 'home_run' || @.result.eventType == 'field_out' || @.result.eventType == 'force_out' || @.result.eventType == 'fielders_choice' || @.result.eventType == 'fielders_choice_out' || @.result.eventType == 'field_error' || @.result.eventType == 'sac_fly' || @.result.eventType == 'sac_bunt' || @.result.eventType == 'double_play' || @.result.eventType == 'grounded_into_double_play')]" .

<#GameMap> a rr:TriplesMap ;
  rml:logicalSource <#RootSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ; rr:class base:BaseballGame ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001918 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/baseball-field" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000199 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/temporal-interval" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000057 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{$.gameData.teams.away.id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000057 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{$.gameData.teams.home.id}" ; rr:termType rr:IRI ]
  ] .

<#GameIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#RootSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/identifier/mlb-game-pk" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "gamePk" ; rr:datatype xsd:string ]
  ] .

<#AwayTeamMap> a rr:TriplesMap ;
  rml:logicalSource <#AwayTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ; rr:class base:BaseballTeam ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#AwayTeamIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#AwayTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}/identifier/mlb-team-id" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "id" ; rr:datatype xsd:string ]
  ] .

<#AwayTeamNameMap> a rr:TriplesMap ;
  rml:logicalSource <#AwayTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}/name/mlb-full" ; rr:termType rr:IRI ; rr:class cco:ont00001014 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#AwayTeamRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#AwayTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/team-role/away" ; rr:termType rr:IRI ; rr:class base:AwayTeamRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000054 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ]
  ] .

<#HomeTeamMap> a rr:TriplesMap ;
  rml:logicalSource <#HomeTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ; rr:class base:BaseballTeam ] ;
  rr:predicateObjectMap [
    rr:predicate rdfs:label ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#HomeTeamIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#HomeTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}/identifier/mlb-team-id" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "id" ; rr:datatype xsd:string ]
  ] .

<#HomeTeamNameMap> a rr:TriplesMap ;
  rml:logicalSource <#HomeTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/team/{id}/name/mlb-full" ; rr:termType rr:IRI ; rr:class cco:ont00001014 ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "name" ]
  ] .

<#HomeTeamRoleMap> a rr:TriplesMap ;
  rml:logicalSource <#HomeTeamSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/team-role/home" ; rr:termType rr:IRI ; rr:class base:HomeTeamRole ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/team/{id}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000054 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ]
  ] .

<#VenueMap> a rr:TriplesMap ;
