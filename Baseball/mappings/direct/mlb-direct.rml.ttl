<#PitchActMap> a rr:TriplesMap ;
  rml:logicalSource <#PitchSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/pitch/{playId}" ; rr:termType rr:IRI ; rr:class base:PitchAct ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000132 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{_baseballO.atBatIndex}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000057 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/player/{_baseballO.pitcherId}" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000055 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/player/{_baseballO.pitcherId}/role/pitcher" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001918 ;
    rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/baseball-field" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
