@prefix idx: <https://w3id.org/baseball/query-index/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix shape: <https://w3id.org/baseball/shacl/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

shape:QueryIndexProfile
    a sh:NodeShape ;
    sh:name "BaseballO disposable query-index profile"@en ;
    sh:description "Structural and containment constraints for query-index contract version 1."@en .

shape:QueryIndexShape
    a sh:NodeShape ;
    sh:targetClass idx:QueryIndex ;
    sh:nodeKind sh:IRI ;
    sh:property [
        sh:path idx:contractVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:hasValue "1" ;
        sh:message "A QueryIndex must declare contract version 1 exactly once."@en
    ] ;
    sh:property [
        sh:path idx:sourceGraph ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A QueryIndex must identify exactly one authoritative source graph."@en
    ] ;
    sh:property [
        sh:path idx:indexedGame ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:class idx:GameFact ;
        sh:message "A QueryIndex must identify exactly one indexed GameFact."@en
    ] ;
    sh:sparql [
        sh:message "A per-game index graph must contain exactly one QueryIndex metadata resource."@en ;
        sh:select """
            PREFIX idx: <https://w3id.org/baseball/query-index/>
            SELECT $this WHERE {
              {
                SELECT (COUNT(DISTINCT ?index) AS ?count)
                WHERE { ?index a idx:QueryIndex }
              }
              FILTER (?count != 1)
            }
        """
    ] .

shape:GameFactShape
    a sh:NodeShape ;
    sh:targetClass idx:GameFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:DerivedFromProperty ;
    sh:property [
        sh:path idx:season ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:message "A GameFact must have exactly one integer season."@en
    ] ;
    sh:property [
        sh:path idx:venue ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "A GameFact must have exactly one venue."@en
    ] ;
    sh:property [
        sh:path idx:gameStart ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:dateTime ;
        sh:message "A GameFact must have exactly one xsd:dateTime start."@en
    ] ;
    sh:sparql [
        sh:message "The only GameFact must be the game named by QueryIndex metadata."@en ;
        sh:select """
            PREFIX idx: <https://w3id.org/baseball/query-index/>
            SELECT $this WHERE {
              ?index a idx:QueryIndex ; idx:indexedGame ?game .
              FILTER ($this != ?game)
            }
        """
    ] .

shape:PlateAppearanceFactShape
    a sh:NodeShape ;
    sh:targetClass idx:PlateAppearanceFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:DerivedFromProperty .

shape:PlateAppearanceResultFactShape
    a sh:NodeShape ;
    sh:targetClass idx:PlateAppearanceResultFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:PlateAppearanceProperty,
        shape:OutcomeClassProperty,
        shape:SourceEventTypeProperty,
        shape:DerivedFromProperty .

shape:HitFactShape
    a sh:NodeShape ;
    sh:targetClass idx:HitFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:VenueProperty,
        shape:PlateAppearanceProperty,
        shape:HitTypeProperty,
        shape:DerivedFromProperty .

shape:PitchFactShape
    a sh:NodeShape ;
    sh:targetClass idx:PitchFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:VenueProperty,
        shape:PlateAppearanceProperty,
        shape:DerivedFromProperty .

shape:PitchCallFactShape
    a sh:NodeShape ;
    sh:targetClass idx:PitchCallFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:PitchProperty,
        shape:CallTypeProperty,
        shape:DerivedFromProperty .

shape:BattingActFactShape
    a sh:NodeShape ;
    sh:targetClass idx:BattingActFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:PlateAppearanceProperty,
        shape:BattingActTypeProperty,
        shape:DerivedFromProperty .

shape:ContactFactShape
    a sh:NodeShape ;
    sh:targetClass idx:ContactFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:VenueProperty,
        shape:PlateAppearanceProperty,
        shape:BattedBallProperty,
        shape:DerivedFromProperty .

shape:RunnerResolutionFactShape
    a sh:NodeShape ;
    sh:targetClass idx:RunnerResolutionFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:ResolutionClassProperty,
        shape:SourceEventTypeProperty,
        shape:DerivedFromProperty .

shape:StolenBaseFactShape
    a sh:NodeShape ;
    sh:targetClass idx:StolenBaseFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AgentProperty,
        shape:DerivedFromProperty .

shape:AssignmentFactShape
    a sh:NodeShape ;
    sh:targetClass idx:AssignmentFact ;
    sh:nodeKind sh:IRI ;
    sh:property shape:GameProperty,
        shape:AssigneeProperty,
        shape:AssignmentTypeProperty,
        shape:DerivedFromProperty .

shape:SameGameFactShape
    a sh:NodeShape ;
    sh:targetSubjectsOf idx:game ;
    sh:sparql [
        sh:message "Every per-game fact must identify the game named by QueryIndex metadata."@en ;
        sh:select """
            PREFIX idx: <https://w3id.org/baseball/query-index/>
            SELECT $this WHERE {
              $this idx:game ?factGame .
              ?index a idx:QueryIndex ; idx:indexedGame ?indexedGame .
              FILTER (?factGame != ?indexedGame)
            }
        """
    ] .

shape:GameProperty
    a sh:PropertyShape ;
    sh:path idx:game ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class idx:GameFact ;
    sh:message "A query-index fact must reference exactly one indexed GameFact."@en .

shape:AgentProperty
    a sh:PropertyShape ;
    sh:path idx:agent ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The fact must identify exactly one agent IRI."@en .

shape:DerivedFromProperty
    a sh:PropertyShape ;
    sh:path idx:derivedFrom ;
    sh:minCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The fact must retain at least one authoritative provenance IRI."@en .

shape:VenueProperty
    a sh:PropertyShape ;
    sh:path idx:venue ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The fact must identify exactly one venue IRI."@en .

shape:PlateAppearanceProperty
    a sh:PropertyShape ;
    sh:path idx:plateAppearance ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class idx:PlateAppearanceFact ;
    sh:message "The fact must identify exactly one indexed PlateAppearanceFact."@en .

shape:OutcomeClassProperty
    a sh:PropertyShape ;
    sh:path idx:outcomeClass ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "The result fact must identify exactly one outcome class IRI."@en .

shape:SourceEventTypeProperty
    a sh:PropertyShape ;
    sh:path idx:sourceEventType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:Literal ;
    sh:message "The fact must retain exactly one source event-type literal."@en .

shape:HitTypeProperty
    a sh:PropertyShape ;
    sh:path idx:hitType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A HitFact must identify exactly one hit type IRI."@en .

shape:PitchProperty
    a sh:PropertyShape ;
    sh:path idx:pitch ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:class idx:PitchFact ;
    sh:message "A PitchCallFact must identify exactly one indexed PitchFact."@en .

shape:CallTypeProperty
    a sh:PropertyShape ;
    sh:path idx:callType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A PitchCallFact must identify exactly one call type IRI."@en .

shape:BattingActTypeProperty
    a sh:PropertyShape ;
    sh:path idx:battingActType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A BattingActFact must identify exactly one act type IRI."@en .

shape:BattedBallProperty
    a sh:PropertyShape ;
    sh:path idx:battedBall ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A ContactFact must identify exactly one batted-ball motion IRI."@en .

shape:ResolutionClassProperty
    a sh:PropertyShape ;
    sh:path idx:resolutionClass ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "A RunnerResolutionFact must identify exactly one resolution class IRI."@en .

shape:AssigneeProperty
    a sh:PropertyShape ;
    sh:path idx:assignee ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "An AssignmentFact must identify exactly one assignee IRI."@en .

shape:AssignmentTypeProperty
    a sh:PropertyShape ;
    sh:path idx:assignmentType ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:nodeKind sh:IRI ;
    sh:message "An AssignmentFact must identify exactly one assignment type IRI."@en .
