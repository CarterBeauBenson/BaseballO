INFO  exec            :: QUERY
  PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>
  PREFIX  obo:  <http://purl.obolibrary.org/obo/>
  PREFIX  cco:  <https://www.commoncoreontologies.org/>
  PREFIX  base: <https://baseballontology.org/>

  SELECT  ?player ?playerLabel (COUNT(DISTINCT ?game) AS ?hitlessGames)
  WHERE
    { VALUES ?graph { <https://w3id.org/baseball/graph/game/822867> <https://w3id.org/baseball/graph/game/823431> <https://w3id.org/baseball/graph/game/823520> <https://w3id.org/baseball/graph/game/823757> <https://w3id.org/baseball/graph/game/824160> <https://w3id.org/baseball/graph/game/824324> <https://w3id.org/baseball/graph/game/824647> <https://w3id.org/baseball/graph/game/825095> }
      GRAPH ?graph
        { ?game     a                base:BaseballGame .
          ?batterAct  a              base:BatterAct ;
                    obo:BFO_0000132  ?plateAppearance ;
                    obo:BFO_0000057  ?player .
          ?plateAppearance (obo:BFO_0000132/obo:BFO_0000132)/obo:BFO_0000132 ?game .
          ?player  rdfs:label  ?playerLabel
          FILTER NOT EXISTS { ?hit      a                base:BaseballInstitutionalProcess ;
                                        a                ?hitClass ;
                                        obo:BFO_0000132  ?hitPlateAppearance ;
                                        obo:BFO_0000117  ?hitJudgment .
                              ?hitJudgment  a            base:HitJudgmentAct .
                              ?hitBatterAct
                                        a                base:BatterAct ;
                                        obo:BFO_0000132  ?hitPlateAppearance ;
                                        obo:BFO_0000057  ?player .
                              ?hitPlateAppearance (obo:BFO_0000132/obo:BFO_0000132)/obo:BFO_0000132 ?game
                              VALUES ?hitClass { base:SingleProcess base:DoubleProcess base:TripleProcess base:HomeRunProcess }
                            }
        }
    }
  GROUP BY ?player ?playerLabel
  ORDER BY DESC(?hitlessGames) lcase(str(?playerLabel))
INFO  exec            :: ALGEBRA
  (project (?player ?playerLabel ?hitlessGames)
    (order ((desc ?hitlessGames) (lcase (str ?playerLabel)))
      (extend ((?hitlessGames ?.0))
        (group (?player ?playerLabel) ((?.0 (count distinct ?game)))
          (sequence
            (table (vars ?graph)
              (row [?graph <https://w3id.org/baseball/graph/game/822867>])
              (row [?graph <https://w3id.org/baseball/graph/game/823431>])
              (row [?graph <https://w3id.org/baseball/graph/game/823520>])
              (row [?graph <https://w3id.org/baseball/graph/game/823757>])
              (row [?graph <https://w3id.org/baseball/graph/game/824160>])
              (row [?graph <https://w3id.org/baseball/graph/game/824324>])
              (row [?graph <https://w3id.org/baseball/graph/game/824647>])
              (row [?graph <https://w3id.org/baseball/graph/game/825095>])
            )
            (filter (notexists
                       (sequence
                         (table (vars ?hitClass)
                           (row [?hitClass <https://baseballontology.org/SingleProcess>])
                           (row [?hitClass <https://baseballontology.org/DoubleProcess>])
                           (row [?hitClass <https://baseballontology.org/TripleProcess>])
                           (row [?hitClass <https://baseballontology.org/HomeRunProcess>])
                         )
                         (quadpattern
                           (quad ?graph ?hit <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://baseballontology.org/BaseballInstitutionalProcess>)
                           (quad ?graph ?hit <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> ?hitClass)
                           (quad ?graph ?hit <http://purl.obolibrary.org/obo/BFO_0000132> ?hitPlateAppearance)
                           (quad ?graph ?hit <http://purl.obolibrary.org/obo/BFO_0000117> ?hitJudgment)
                           (quad ?graph ?hitJudgment <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://baseballontology.org/HitJudgmentAct>)
                           (quad ?graph ?hitBatterAct <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://baseballontology.org/BatterAct>)
                           (quad ?graph ?hitBatterAct <http://purl.obolibrary.org/obo/BFO_0000132> ?hitPlateAppearance)
                           (quad ?graph ?hitBatterAct <http://purl.obolibrary.org/obo/BFO_0000057> ?player)
                           (quad ?graph ?hitPlateAppearance <http://purl.obolibrary.org/obo/BFO_0000132> ??P1)
                           (quad ?graph ??P1 <http://purl.obolibrary.org/obo/BFO_0000132> ??P0)
                           (quad ?graph ??P0 <http://purl.obolibrary.org/obo/BFO_0000132> ?game)
                         )))
              (quadpattern
                (quad ?graph ?game <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://baseballontology.org/BaseballGame>)
                (quad ?graph ?batterAct <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://baseballontology.org/BatterAct>)
                (quad ?graph ?batterAct <http://purl.obolibrary.org/obo/BFO_0000132> ?plateAppearance)
                (quad ?graph ?batterAct <http://purl.obolibrary.org/obo/BFO_0000057> ?player)
                (quad ?graph ?plateAppearance <http://purl.obolibrary.org/obo/BFO_0000132> ??P3)
                (quad ?graph ??P3 <http://purl.obolibrary.org/obo/BFO_0000132> ??P2)
                (quad ?graph ??P2 <http://purl.obolibrary.org/obo/BFO_0000132> ?game)
                (quad ?graph ?player <http://www.w3.org/2000/01/rdf-schema#label> ?playerLabel)
              )))))))
INFO  exec            :: TDB2
  (project (?player ?playerLabel ?hitlessGames)
    (order ((desc ?hitlessGames) (lcase (str ?playerLabel)))
      (extend ((?hitlessGames ?.0))
        (group (?player ?playerLabel) ((?.0 (count distinct ?game)))
          (sequence
            (table (vars ?graph)
              (row [?graph <https://w3id.org/baseball/graph/game/822867>])
              (row [?graph <https://w3id.org/baseball/graph/game/823431>])
              (row [?graph <https://w3id.org/baseball/graph/game/823520>])
