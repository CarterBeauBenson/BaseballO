INFO  exec            :: Execute
  ?pitch rdf:type <https://w3id.org/baseball/query-index/PitchFact>
  ?pitch <https://w3id.org/baseball/query-index/agent> ?pitcher
  ?pitch <https://w3id.org/baseball/query-index/venue> ?venue
  ?pitcher rdfs:label ?pitcherLabel
