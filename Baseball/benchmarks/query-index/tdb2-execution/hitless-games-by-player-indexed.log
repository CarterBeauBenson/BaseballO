INFO  exec            :: QUERY
  PREFIX  idx:  <https://w3id.org/baseball/query-index/>
  PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>

  SELECT  ?player ?playerLabel (COUNT(DISTINCT ?game) AS ?hitlessGames)
  WHERE
    { VALUES ?graph { <https://w3id.org/baseball/graph/query-index/game/822867> <https://w3id.org/baseball/graph/query-index/game/823431> <https://w3id.org/baseball/graph/query-index/game/823520> <https://w3id.org/baseball/graph/query-index/game/823757> <https://w3id.org/baseball/graph/query-index/game/824160> <https://w3id.org/baseball/graph/query-index/game/824324> <https://w3id.org/baseball/graph/query-index/game/824647> <https://w3id.org/baseball/graph/query-index/game/825095> }
      GRAPH ?graph
        { ?game     a           idx:GameFact .
          ?plateAppearance
                    a           idx:PlateAppearanceFact ;
                    idx:agent   ?player ;
                    idx:game    ?game .
          ?player   rdfs:label  ?playerLabel
          FILTER NOT EXISTS { ?hit  a          idx:HitFact ;
                                    idx:agent  ?player ;
                                    idx:game   ?game
                            }
        }
    }
  GROUP BY ?player ?playerLabel
  ORDER BY DESC(?hitlessGames) lcase(str(?playerLabel))
INFO  exec            :: ALGEBRA
  (project (?player ?playerLabel ?hitlessGames)
    (order ((desc ?hitlessGames) (lcase (str ?playerLabel)))
      (extend ((?hitlessGames ?.0))
        (group (?player ?playerLabel) ((?.0 (count distinct ?game)))
          (sequence
            (table (vars ?graph)
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/822867>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/823431>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/823520>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/823757>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/824160>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/824324>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/824647>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/825095>])
            )
            (filter (notexists
                       (quadpattern
                         (quad ?graph ?hit <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/baseball/query-index/HitFact>)
                         (quad ?graph ?hit <https://w3id.org/baseball/query-index/agent> ?player)
                         (quad ?graph ?hit <https://w3id.org/baseball/query-index/game> ?game)
                       ))
              (quadpattern
                (quad ?graph ?game <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/baseball/query-index/GameFact>)
                (quad ?graph ?plateAppearance <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/baseball/query-index/PlateAppearanceFact>)
                (quad ?graph ?plateAppearance <https://w3id.org/baseball/query-index/agent> ?player)
                (quad ?graph ?plateAppearance <https://w3id.org/baseball/query-index/game> ?game)
                (quad ?graph ?player <http://www.w3.org/2000/01/rdf-schema#label> ?playerLabel)
              )))))))
INFO  exec            :: TDB2
  (project (?player ?playerLabel ?hitlessGames)
    (order ((desc ?hitlessGames) (lcase (str ?playerLabel)))
      (extend ((?hitlessGames ?.0))
        (group (?player ?playerLabel) ((?.0 (count distinct ?game)))
