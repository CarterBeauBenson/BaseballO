INFO  exec            :: QUERY
  PREFIX  idx:  <https://w3id.org/baseball/query-index/>
  PREFIX  rdfs: <http://www.w3.org/2000/01/rdf-schema#>

  SELECT  ?pitcher ?pitcherLabel (COUNT(DISTINCT ?pitch) AS ?pitches) (COUNT(DISTINCT ?ball) AS ?balls) (COUNT(DISTINCT ?strike) AS ?strikes) (COUNT(DISTINCT ?plateAppearance) AS ?plateAppearances)
  WHERE
    { VALUES ?graph { <https://w3id.org/baseball/graph/query-index/game/822867> <https://w3id.org/baseball/graph/query-index/game/823431> <https://w3id.org/baseball/graph/query-index/game/823520> <https://w3id.org/baseball/graph/query-index/game/823757> <https://w3id.org/baseball/graph/query-index/game/824160> <https://w3id.org/baseball/graph/query-index/game/824324> <https://w3id.org/baseball/graph/query-index/game/824647> <https://w3id.org/baseball/graph/query-index/game/825095> }
      GRAPH ?graph
        { ?pitch    a                    idx:PitchFact ;
                    idx:agent            ?pitcher ;
                    idx:plateAppearance  ?plateAppearance .
          ?pitcher  rdfs:label           ?pitcherLabel
          OPTIONAL
            { ?ball  a             idx:PitchCallFact ;
                     idx:pitch     ?pitch ;
                     idx:callType  idx:Ball
            }
          OPTIONAL
            { ?strike  a             idx:PitchCallFact ;
                       idx:pitch     ?pitch ;
                       idx:callType  idx:Strike
            }
        }
    }
  GROUP BY ?pitcher ?pitcherLabel
  ORDER BY DESC(?pitches) lcase(str(?pitcherLabel))
INFO  exec            :: ALGEBRA
  (project (?pitcher ?pitcherLabel ?pitches ?balls ?strikes ?plateAppearances)
    (order ((desc ?pitches) (lcase (str ?pitcherLabel)))
      (extend ((?pitches ?.0) (?balls ?.1) (?strikes ?.2) (?plateAppearances ?.3))
        (group (?pitcher ?pitcherLabel) ((?.0 (count distinct ?pitch)) (?.1 (count distinct ?ball)) (?.2 (count distinct ?strike)) (?.3 (count distinct ?plateAppearance)))
          (sequence
            (table (vars ?graph)
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/822867>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/823431>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/823520>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/823757>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/824160>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/824324>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/824647>])
              (row [?graph <https://w3id.org/baseball/graph/query-index/game/825095>])
            )
            (conditional
              (conditional
                (quadpattern
                  (quad ?graph ?pitch <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/baseball/query-index/PitchFact>)
                  (quad ?graph ?pitch <https://w3id.org/baseball/query-index/agent> ?pitcher)
                  (quad ?graph ?pitch <https://w3id.org/baseball/query-index/plateAppearance> ?plateAppearance)
                  (quad ?graph ?pitcher <http://www.w3.org/2000/01/rdf-schema#label> ?pitcherLabel)
                )
                (quadpattern
                  (quad ?graph ?ball <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/baseball/query-index/PitchCallFact>)
                  (quad ?graph ?ball <https://w3id.org/baseball/query-index/pitch> ?pitch)
                  (quad ?graph ?ball <https://w3id.org/baseball/query-index/callType> <https://w3id.org/baseball/query-index/Ball>)
                ))
              (quadpattern
                (quad ?graph ?strike <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <https://w3id.org/baseball/query-index/PitchCallFact>)
                (quad ?graph ?strike <https://w3id.org/baseball/query-index/pitch> ?pitch)
                (quad ?graph ?strike <https://w3id.org/baseball/query-index/callType> <https://w3id.org/baseball/query-index/Strike>)
              )))))))
