    "query": "PREFIX base: <https://baseballontology.org/>\nPREFIX cco: <https://www.commoncoreontologies.org/>\nPREFIX obo: <http://purl.obolibrary.org/obo/>\nSELECT *\nFROM NAMED <https://w3id.org/baseball/graph/game/822693>\nFROM NAMED <https://w3id.org/baseball/graph/game/822773>\nFROM NAMED <https://w3id.org/baseball/graph/game/823016>\nFROM NAMED <https://w3id.org/baseball/graph/game/823098>\nFROM NAMED <https://w3id.org/baseball/graph/game/823181>\nFROM NAMED <https://w3id.org/baseball/graph/game/823259>\nFROM NAMED <https://w3id.org/baseball/graph/game/823505>\nFROM NAMED <https://w3id.org/baseball/graph/game/823585>\nFROM NAMED <https://w3id.org/baseball/graph/game/823826>\nFROM NAMED <https://w3id.org/baseball/graph/game/823989>\nFROM NAMED <https://w3id.org/baseball/graph/game/824233>\nFROM NAMED <https://w3id.org/baseball/graph/game/824556>\nFROM NAMED <https://w3id.org/baseball/graph/game/824881>\nFROM NAMED <https://w3id.org/baseball/graph/game/824962>\nFROM NAMED <https://w3id.org/baseball/graph/game/825042>\nWHERE {\n{ {\n\n# Existing-term evidence inventory, not a completeness certificate. Every row\n# keeps its promoted graph and world-side referent. No provider event labels,\n# inferred continuity, inferred causation, or missing-row negative assertions.\nSELECT DISTINCT ?graph ?game ?kind ?entity ?player ?act ?roleType\n                ?reviewRecord ?original ?operative ?disposition ?decision\nWHERE {\n  VALUES ?graph { <https://w3id.org/baseball/graph/game/822693> <https://w3id.org/baseball/graph/game/822773> <https://w3id.org/baseball/graph/game/823016> <https://w3id.org/baseball/graph/game/823098> <https://w3id.org/baseball/graph/game/823181> <https://w3id.org/baseball/graph/game/823259> <https://w3id.org/baseball/graph/game/823505> <https://w3id.org/baseball/graph/game/823585> <https://w3id.org/baseball/graph/game/823826> <https://w3id.org/baseball/graph/game/823989> <https://w3id.org/baseball/graph/game/824233> <https://w3id.org/baseball/graph/game/824556> <https://w3id.org/baseball/graph/game/824881> <https://w3id.org/baseball/graph/game/824962> <https://w3id.org/baseball/graph/game/825042> }\n  GRAPH ?graph {\n    ?game a base:BaseballGame .\n    {\n      ?entity a base:PlateAppearance ;\n          obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .\n      BIND(\"plate_appearance\" AS ?kind)\n    } UNION {\n      VALUES (?entityType ?kind) {\n        (base:BattedBallPlayProcess \"batted_play\") (base:RunProcess \"run\")\n      }\n      ?entity a ?entityType ; obo:BFO_0000132+ ?game .\n    } UNION {\n      ?act obo:BFO_0000132+ ?game ; obo:BFO_0000055 ?role .\n      ?role obo:BFO_0000197 ?player ; a ?roleType .\n      VALUES ?roleType { base:BatterRole base:BaserunnerRole base:PitcherRole base:FielderRole }\n      BIND(?player AS ?entity)\n      BIND(\"player_game\" AS ?kind)\n    } UNION {\n      ?entity a base:BaseballReplayReviewAct .\n      ?reviewRecord a base:BaseballReplayReviewEventRecord ;\n        cco:ont00001808 ?entity, ?resultJudgment .\n      ?resultJudgment obo:BFO_0000132 ?result .\n      ?result a base:BaseballInstitutionalProcess ; obo:BFO_0000132 ?reviewPA .\n      ?reviewPA a base:PlateAppearance ;\n        obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .\n      BIND(\"review\" AS ?kind)\n      OPTIONAL {\n        ?reviewRecord a base:BaseballReplayReviewEventRecord ;\n          cco:ont00001808 ?entity, ?onFieldJudgment, ?original, ?operative, ?disposition .\n        ?onFieldJudgment a base:ReviewedOnFieldUmpireJudgmentAct ;\n          cco:ont00001986 ?original ; obo:BFO_0000063 ?entity .\n        ?entity cco:ont00001921 ?original ; cco:ont00001986 ?operative .\n        ?original a base:ReviewedOnFieldBaseballDecisionICE .\n        ?operative a base:BaseballReplayDecisionICE .\n        ?disposition a base:BaseballReplayReviewDispositionICE, ?dispositionType ;\n          cco:ont00001816 ?entity ; cco:ont00001808 ?original, ?operative .\n        VALUES (?dispositionType ?decision) {\n          (base:AffirmingBaseballReplayReviewDispositionICE \"affirmed\")\n          (base:OverturningBaseballReplayReviewDispositionICE \"reversed\")\n        }\n      }\n    }\n  }\n  FILTER(STRSTARTS(STR(?graph), \"https://w3id.org/baseball/graph/game/\"))\n}\n\n} } UNION { {\n\n# Read-only evidence over accepted MLB-game relations, not scored trajectories.\n# Each distinct combination remains visible; no path coalescence or credit is\n# inferred. Unbound values remain unknown. Codes come from explicit identifiers.\nSELECT DISTINCT ?graph ?game ?plateAppearance ?resolution ?act ?runner ?episode\n       ?originDesignation ?originRecord ?originBase ?originCode ?destinationBase ?destinationCode\n       ?safeJudgment ?safeDecision\n       ?trajectory ?trajectoryHalf ?trajectoryInterval\n       ?batter ?metricOrigin ?awardRule\n       ?contactPlay ?award ?record ?hasSafeType ?hasOutType ?hasRunType\nWHERE {\n  VALUES ?graph { <https://w3id.org/baseball/graph/game/822693> <https://w3id.org/baseball/graph/game/822773> <https://w3id.org/baseball/graph/game/823016> <https://w3id.org/baseball/graph/game/823098> <https://w3id.org/baseball/graph/game/823181> <https://w3id.org/baseball/graph/game/823259> <https://w3id.org/baseball/graph/game/823505> <https://w3id.org/baseball/graph/game/823585> <https://w3id.org/baseball/graph/game/823826> <https://w3id.org/baseball/graph/game/823989> <https://w3id.org/baseball/graph/game/824233> <https://w3id.org/baseball/graph/game/824556> <https://w3id.org/baseball/graph/game/824881> <https://w3id.org/baseball/graph/game/824962> <https://w3id.org/baseball/graph/game/825042> }\n  GRAPH ?graph {\n    ?game a base:BaseballGame .\n    ?plateAppearance a base:PlateAppearance ;\n        obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .\n    ?resolution a base:RunnerResolutionProcess ;\n        obo:BFO_0000132 ?plateAppearance ; obo:BFO_0000062 ?act .\n    ?act a base:BaserunningAct ; obo:BFO_0000132 ?plateAppearance .\n    OPTIONAL { ?episode a base:RunnerResolutionEpisode ; obo:BFO_0000132 ?plateAppearance ;\n          obo:BFO_0000117 ?resolution, ?act .\n      ?act a base:BaserunningAct ; cco:ont00001833 ?runner ; obo:BFO_0000132 ?plateAppearance .\n      OPTIONAL {\n        ?trajectory a obo:BFO_0000015 ; obo:BFO_0000117 ?episode ;\n            obo:BFO_0000057 ?runner ; obo:BFO_0000132 ?trajectoryHalf ;\n            obo:BFO_0000199 ?trajectoryInterval .\n        ?trajectoryHalf a base:HalfInning .\n        ?trajectoryInterval a obo:BFO_0000038 .\n        ?plateAppearance obo:BFO_0000132 ?trajectoryHalf .\n        FILTER(REGEX(STR(?trajectory), \"^https://baseballontology[.]org/data/game/[0-9]+/runner-trajectory/[^/]+$\"))\n      }\n    }\n    OPTIONAL {\n      ?originDesignation a base:BaserunningSegmentOriginDesignation ;\n          cco:ont00001808 ?act ; cco:ont00001916 ?originBase .\n        ?originBase a base:Base .\n      OPTIONAL {\n        ?originDesignation obo:BFO_0000176 ?originRecord .\n        ?originRecord a base:BaseballEventRecord .\n      }\n      OPTIONAL {\n        ?originIdentifier a cco:ont00000649 ; cco:ont00001916 ?originBase ;\n            cco:ont00001765 ?originCode .\n      }\n    }\n    OPTIONAL {\n      ?resolution a base:SafeProcess ; obo:BFO_0000117 ?safeJudgment .\n      ?safeJudgment a base:SafeJudgmentAct ; cco:ont00001986 ?safeDecision .\n      ?safeDecision a base:SafeDecisionICE ; cco:ont00001808 ?resolution, ?destinationBase .\n      ?destinationBase a base:Base .\n      OPTIONAL {\n        ?destinationIdentifier a cco:ont00000649 ;\n            cco:ont00001916 ?destinationBase ; cco:ont00001765 ?destinationCode .\n      }\n    }\n    OPTIONAL {\n      ?contactPlay a base:BattedBallPlayProcess ;\n          obo:BFO_0000132 ?plateAppearance ; obo:BFO_0000117 ?resolution .\n    }\n    OPTIONAL {\n      ?award obo:BFO_0000132 ?plateAppearance ; cco:ont00001803 ?act .\n        { ?award a base:WalkProcess } UNION { ?award a base:HitByPitchProcess }\n        ?awardRule a base:BaseballRule ; cco:ont00001974 ?act .\n        ?awardEpisode a base:RunnerResolutionEpisode ; obo:BFO_0000117 ?act, ?resolution .\n        { ?resolution a base:SafeProcess } UNION { ?resolution a base:RunProcess }\n    }\n    OPTIONAL {\n      ?record a base:BaseballEventRecord ; cco:ont00001808 ?resolution, ?act .\n    }\n    OPTIONAL {\n      ?batterAct a base:BatterAct ; obo:BFO_0000132 ?plateAppearance ; obo:BFO_0000055 ?batterRole .\n      ?batterRole a base:BatterRole ; obo:BFO_0000197 ?batter .\n    }\n    # HOME=0 is an analytical initial position, never an RDF origin assertion.\n    BIND(IF(?originCode = \"1B\", 1, IF(?originCode = \"2B\", 2, IF(?originCode = \"3B\", 3, 1/0))) AS ?segmentOriginPosition)\n    BIND(IF(BOUND(?batter) && ?runner = ?batter, 0, ?segmentOriginPosition) AS ?metricOrigin)\n    BIND(EXISTS { ?resolution a base:SafeProcess } AS ?hasSafeType)\n    BIND(EXISTS { ?resolution a base:OutProcess } AS ?hasOutType)\n    BIND(EXISTS { ?resolution a base:RunProcess } AS ?hasRunType)\n  }\n  FILTER(STRSTARTS(STR(?graph), \"https://w3id.org/baseball/graph/game/\"))\n}\nORDER BY ?game ?plateAppearance ?resolution ?act\n\n} BIND(\"runner_movement\" AS ?kind) BIND(?resolution AS ?entity) }\n}",
