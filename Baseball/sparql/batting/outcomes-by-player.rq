PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?player ?playerLabel ?eventType
       (COUNT(DISTINCT ?result) AS ?plateAppearances)
WHERE {
  GRAPH ?graph {
    ?record a base:BaseballEventRecord ;
            cco:ont00001808 ?result ;
            dcterms:identifier ?eventType .
    ?result a base:BaseballInstitutionalProcess ;
            obo:BFO_0000132 ?plateAppearance .
    ?batterAct a base:BatterAct ;
               obo:BFO_0000132 ?plateAppearance ;
               cco:ont00001833 ?player .
    ?player rdfs:label ?playerLabel .
  }
}
GROUP BY ?player ?playerLabel ?eventType
ORDER BY LCASE(STR(?playerLabel)) DESC(?plateAppearances) ?eventType
