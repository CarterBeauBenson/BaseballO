PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Final observed call-process distribution. A replay disposition is attached
# when MLB marks the pitch result as reviewed. "overturned" means replay
# reversed the on-field call; callType is still the final post-review outcome.
# Without pitch-location measurements this cannot assess strike-zone accuracy.
SELECT ?umpire ?umpireLabel ?callType ?reviewDisposition
       (COUNT(DISTINCT ?judgment) AS ?calls)
       (COUNT(DISTINCT ?game) AS ?games)
WHERE {
  GRAPH ?graph {
    ?umpireRole a base:UmpireRole ;
        obo:BFO_0000197 ?umpire ;
        obo:BFO_0000054 ?game .
    ?umpire rdfs:label ?umpireLabel .
    {
      ?record a base:BaseballEventRecord ;
          cco:ont00001808 ?pitch, ?ballProcess ;
          dcterms:type ?pitchCallCode .
      ?pitch a base:PitchAct .
      ?ballProcess a base:BallProcess ; obo:BFO_0000117 ?judgment .
      ?judgment a base:BallJudgmentAct ; obo:BFO_0000055 ?umpireRole .
    }
    UNION
    {
      ?record a base:BaseballEventRecord ;
          cco:ont00001808 ?pitch, ?foulTipProcess ;
          dcterms:type ?pitchCallCode .
      ?pitch a base:PitchAct .
      ?foulTipProcess a base:FoulTipProcess ; obo:BFO_0000117 ?judgment .
      ?judgment a base:FoulTipJudgmentAct ; obo:BFO_0000055 ?umpireRole .
    }
    UNION
    {
      ?record a base:BaseballEventRecord ;
          cco:ont00001808 ?pitch, ?strikeProcess ;
          dcterms:type ?pitchCallCode .
      ?pitch a base:PitchAct .
      ?strikeProcess a base:StrikeProcess ; obo:BFO_0000117 ?judgment .
      ?judgment a base:StrikeJudgmentAct ; obo:BFO_0000055 ?umpireRole .
      FILTER NOT EXISTS { ?judgment a base:FoulTipJudgmentAct . }
    }
    VALUES (?pitchCallCode ?callType) {
      ("B" "ball") ("*B" "ball") ("C" "called_strike")
      ("S" "swinging_strike") ("F" "foul") ("T" "foul_tip")
    }
    OPTIONAL {
      ?reviewRecord a base:BaseballEventRecord ;
          cco:ont00001808 ?pitch ;
          dcterms:type "pitch_result" ;
          dcterms:identifier ?reviewStatus .
    }
    BIND(COALESCE(?reviewStatus, "not_reviewed") AS ?reviewDisposition)
  }
  FILTER(STRSTARTS(STR(?graph), "https://w3id.org/baseball/graph/game/"))
}
GROUP BY ?umpire ?umpireLabel ?callType ?reviewDisposition
ORDER BY ?umpireLabel ?callType ?reviewDisposition
