PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Observed call-process distribution. Called/swing-associated distinctions use
# the mapped swing relation. Without pitch-location measurements this cannot
# assess strike-zone accuracy.
SELECT ?umpire ?umpireLabel ?callType
       (COUNT(DISTINCT ?judgment) AS ?calls)
       (COUNT(DISTINCT ?game) AS ?games)
WHERE {
  GRAPH ?graph {
    ?umpireRole a base:UmpireRole ;
        obo:BFO_0000197 ?umpire ;
        obo:BFO_0000054 ?game .
    ?umpire rdfs:label ?umpireLabel .
    {
      ?record a base:BaseballEventRecord ; cco:ont00001808 ?pitch, ?ballProcess .
      ?pitch a base:PitchAct .
      ?ballProcess a base:BallProcess ; obo:BFO_0000117 ?judgment .
      ?judgment a base:BallJudgmentAct ; obo:BFO_0000055 ?umpireRole .
      BIND("ball" AS ?callType)
    }
    UNION
    {
      ?record a base:BaseballEventRecord ; cco:ont00001808 ?pitch, ?foulTipProcess .
      ?pitch a base:PitchAct .
      ?foulTipProcess a base:FoulTipProcess ; obo:BFO_0000117 ?judgment .
      ?judgment a base:FoulTipJudgmentAct ; obo:BFO_0000055 ?umpireRole .
      BIND("foul_tip" AS ?callType)
    }
    UNION
    {
      ?record a base:BaseballEventRecord ; cco:ont00001808 ?pitch, ?strikeProcess .
      ?pitch a base:PitchAct .
      ?strikeProcess a base:StrikeProcess ; obo:BFO_0000117 ?judgment .
      ?judgment a base:StrikeJudgmentAct ; obo:BFO_0000055 ?umpireRole .
      FILTER NOT EXISTS { ?judgment a base:FoulTipJudgmentAct . }
      OPTIONAL { ?swing a base:SwingAct ; obo:BFO_0000062 ?pitch . }
      OPTIONAL { ?swing obo:BFO_0000063 ?contact . ?contact a base:BatBallContactProcess . }
      BIND(
        IF(!BOUND(?swing), "called_strike",
          IF(BOUND(?contact), "contacted_strike", "swinging_strike"))
        AS ?callType
      )
    }
  }
  FILTER(STRSTARTS(STR(?graph), "https://w3id.org/baseball/graph/game/"))
}
GROUP BY ?umpire ?umpireLabel ?callType
ORDER BY ?umpireLabel DESC(?calls) ?callType
