PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# SME-facing pitch-call distribution. Unreviewed calls have the same on-field
# and operative call. Reviewed pitch calls report the on-field umpire decision
# separately from the replay decision, so an overturned call is not credited
# to the umpire as though the umpire originally made the post-review call.
# Without pitch-location measurements this does not assess strike-zone accuracy.
SELECT ?umpire ?umpireLabel ?onFieldCall ?operativeCall
       ?reviewOutcome ?sourceReviewStatus
       (COUNT(DISTINCT ?pitch) AS ?calls)
       (COUNT(DISTINCT ?game) AS ?games)
WHERE {
  GRAPH ?graph {
    ?umpireRole a base:UmpireRole ;
        obo:BFO_0000197 ?umpire ;
        obo:BFO_0000054 ?game .
    ?umpire rdfs:label ?umpireLabel .

    {
      {
        ?record a base:BaseballEventRecord ;
            cco:ont00001808 ?pitch, ?ballProcess ;
            dcterms:type ?pitchCallCode .
        ?pitch a base:PitchAct .
        ?ballProcess a base:BallProcess ; obo:BFO_0000117 ?judgment .
        ?judgment a base:BallJudgmentAct ; obo:BFO_0000055 ?umpireRole .
      }
      UNION
      {
        ?record a base:BaseballEventRecord ;
            cco:ont00001808 ?pitch, ?foulTipProcess ;
            dcterms:type ?pitchCallCode .
        ?pitch a base:PitchAct .
        ?foulTipProcess a base:FoulTipProcess ; obo:BFO_0000117 ?judgment .
        ?judgment a base:FoulTipJudgmentAct ; obo:BFO_0000055 ?umpireRole .
      }
      UNION
      {
        ?record a base:BaseballEventRecord ;
            cco:ont00001808 ?pitch, ?strikeProcess ;
            dcterms:type ?pitchCallCode .
        ?pitch a base:PitchAct .
        ?strikeProcess a base:StrikeProcess ; obo:BFO_0000117 ?judgment .
        ?judgment a base:StrikeJudgmentAct ; obo:BFO_0000055 ?umpireRole .
        FILTER NOT EXISTS { ?judgment a base:FoulTipJudgmentAct . }
      }
      VALUES (?pitchCallCode ?unreviewedCall) {
        ("B" "ball") ("*B" "ball") ("C" "called_strike")
        ("S" "swinging_strike") ("F" "foul") ("T" "foul_tip")
      }
      FILTER NOT EXISTS {
        ?reviewRecord a base:BaseballReplayReviewEventRecord ;
            cco:ont00001808 ?pitch .
      }
      BIND(?unreviewedCall AS ?onFieldCall)
      BIND(?unreviewedCall AS ?operativeCall)
      BIND("not_reviewed" AS ?reviewOutcome)
      BIND("not_reviewed" AS ?sourceReviewStatus)
    }
    UNION
    {
      ?reviewRecord a base:BaseballReplayReviewEventRecord ;
          cco:ont00001808 ?pitch, ?onFieldJudgment, ?reviewAct, ?reviewResult .
      ?pitch a base:PitchAct .
      ?onFieldJudgment a base:ReviewedOnFieldUmpireJudgmentAct ;
          obo:BFO_0000055 ?umpireRole ;
          cco:ont00001986 ?onFieldDecision .
      ?reviewAct a base:BaseballReplayReviewAct ;
          cco:ont00001921 ?onFieldDecision ;
          cco:ont00001986 ?replayDecision .
      ?reviewResult a base:BaseballReplayReviewDispositionICE, ?reviewResultClass ;
          dcterms:identifier ?sourceReviewStatus .
      ?onFieldDecision a ?onFieldDecisionClass .
      ?replayDecision a base:BaseballReplayDecisionICE, ?replayDecisionClass .

      VALUES (?onFieldDecisionClass ?onFieldCall) {
        (base:BallDecisionICE "ball")
        (base:StrikeDecisionICE "called_strike")
      }
      VALUES (?replayDecisionClass ?operativeCall) {
        (base:BallDecisionICE "ball")
        (base:StrikeDecisionICE "called_strike")
      }
      VALUES (?reviewResultClass ?reviewOutcome) {
        (base:AffirmingBaseballReplayReviewDispositionICE "affirmed")
        (base:OverturningBaseballReplayReviewDispositionICE "overturned")
      }
    }
  }
  FILTER(STRSTARTS(STR(?graph), "https://w3id.org/baseball/graph/game/"))
}
GROUP BY ?umpire ?umpireLabel ?onFieldCall ?operativeCall
         ?reviewOutcome ?sourceReviewStatus
ORDER BY ?umpireLabel ?onFieldCall ?operativeCall ?reviewOutcome
