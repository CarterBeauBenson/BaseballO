PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?season ?player ?playerLabel
       (COUNT(DISTINCT ?run) AS ?runs)
       (COUNT(DISTINCT ?game) AS ?gamesScoredIn)
WHERE {
  GRAPH ?graph {
    ?game a base:BaseballGame ;
          obo:BFO_0000199/obo:BFO_0000222 ?startInstant .
    ?timestamp a base:BaseballTimestampICE ;
               cco:ont00001916 ?startInstant ;
               cco:ont00001767 ?gameStart .
    ?run a base:RunnerResolutionProcess, base:RunProcess ;
         obo:BFO_0000132 ?plateAppearance ;
         obo:BFO_0000057 ?player ;
         obo:BFO_0000117 ?runJudgment .
    ?plateAppearance a base:PlateAppearance ;
        obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .
    ?runJudgment a base:RunJudgmentAct .
    ?player rdfs:label ?playerLabel .
    BIND(YEAR(?gameStart) AS ?season)
  }
}
GROUP BY ?season ?player ?playerLabel
ORDER BY ?season DESC(?runs) LCASE(STR(?playerLabel))
