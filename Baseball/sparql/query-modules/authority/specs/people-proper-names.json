  "projection": ["authorityGraph", "entity", "nameICE", "nameText"],
  "values": [],
  "orderBy": [
    {"variable": "nameText", "direction": "asc"},
    {"variable": "entity", "direction": "asc"}
  ],
  "materialization": {
    "partitioning": "authority-graphs",
    "rowGrain": "person-proper-name",
    "key": ["authorityGraph", "nameICE"],
    "merge": "replace-source-graph"
  }
}
