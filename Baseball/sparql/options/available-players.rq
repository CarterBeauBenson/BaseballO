PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Restricts the player select box to people observed as batters.
SELECT DISTINCT ?player ?playerLabel
WHERE {
  GRAPH ?graph {
    ?batterAct a base:BatterAct ;
               cco:ont00001833 ?player .
    ?player rdfs:label ?playerLabel .
  }
}
ORDER BY LCASE(STR(?playerLabel))
