PREFIX base: <https://baseballontology.org/>
PREFIX bfo: <http://purl.obolibrary.org/obo/>
PREFIX cco: <https://www.commoncoreontologies.org/>

# Read-only evidence over accepted MLB-game relations, not scored trajectories.
# Each distinct combination remains visible; no path coalescence or credit is
# inferred. Unbound values remain unknown. Codes come from explicit identifiers.
SELECT DISTINCT ?graph ?game ?plateAppearance ?resolution ?act ?runner ?episode
       ?originDesignation ?originRecord ?originBase ?originCode ?destinationBase ?destinationCode
       ?safeJudgment ?safeDecision
       ?batter ?metricOrigin ?awardRule
       ?contactPlay ?award ?record ?hasSafeType ?hasOutType ?hasRunType
WHERE {
  GRAPH ?graph {
    ?game a base:BaseballGame .
    ?plateAppearance a base:PlateAppearance ;
        bfo:BFO_0000132/bfo:BFO_0000132/bfo:BFO_0000132 ?game .
    ?resolution a base:RunnerResolutionProcess ;
        bfo:BFO_0000132 ?plateAppearance ; bfo:BFO_0000062 ?act .
    ?act a base:BaserunningAct ; bfo:BFO_0000132 ?plateAppearance .
    OPTIONAL { ?episode a base:RunnerResolutionEpisode ; bfo:BFO_0000132 ?plateAppearance ;
          bfo:BFO_0000117 ?resolution, ?act .
      ?act a base:BaserunningAct ; cco:ont00001833 ?runner ; bfo:BFO_0000132 ?plateAppearance . }
    OPTIONAL {
      ?originDesignation a base:BaserunningSegmentOriginDesignation ;
          cco:ont00001808 ?act ; cco:ont00001916 ?originBase .
        ?originBase a base:Base .
      OPTIONAL {
        ?originDesignation bfo:BFO_0000176 ?originRecord .
        ?originRecord a base:BaseballEventRecord .
      }
      OPTIONAL {
        ?originIdentifier a cco:ont00000649 ; cco:ont00001916 ?originBase ;
            cco:ont00001765 ?originCode .
      }
    }
    OPTIONAL {
      ?resolution a base:SafeProcess ; bfo:BFO_0000117 ?safeJudgment .
      ?safeJudgment a base:SafeJudgmentAct ; cco:ont00001986 ?safeDecision .
      ?safeDecision a base:SafeDecisionICE ; cco:ont00001808 ?resolution, ?destinationBase .
      ?destinationBase a base:Base .
      OPTIONAL {
        ?destinationIdentifier a cco:ont00000649 ;
            cco:ont00001916 ?destinationBase ; cco:ont00001765 ?destinationCode .
      }
    }
    OPTIONAL {
      ?contactPlay a base:BattedBallPlayProcess ;
          bfo:BFO_0000132 ?plateAppearance ; bfo:BFO_0000117 ?resolution .
    }
    OPTIONAL {
      ?award bfo:BFO_0000132 ?plateAppearance ; cco:ont00001803 ?act .
        { ?award a base:WalkProcess } UNION { ?award a base:HitByPitchProcess }
        ?awardRule a base:BaseballRule ; cco:ont00001974 ?act .
        ?awardEpisode a base:RunnerResolutionEpisode ; bfo:BFO_0000117 ?act, ?resolution .
        { ?resolution a base:SafeProcess } UNION { ?resolution a base:RunProcess }
    }
    OPTIONAL {
      ?record a base:BaseballEventRecord ; cco:ont00001808 ?resolution, ?act .
    }
    OPTIONAL {
      ?batterAct a base:BatterAct ; bfo:BFO_0000132 ?plateAppearance ; bfo:BFO_0000055 ?batterRole .
      ?batterRole a base:BatterRole ; bfo:BFO_0000197 ?batter .
    }
    # HOME=0 is an analytical initial position, never an RDF origin assertion.
    BIND(IF(?originCode = "1B", 1, IF(?originCode = "2B", 2, IF(?originCode = "3B", 3, 1/0))) AS ?segmentOriginPosition)
    BIND(IF(BOUND(?batter) && ?runner = ?batter, 0, ?segmentOriginPosition) AS ?metricOrigin)
    BIND(EXISTS { ?resolution a base:SafeProcess } AS ?hasSafeType)
    BIND(EXISTS { ?resolution a base:OutProcess } AS ?hasOutType)
    BIND(EXISTS { ?resolution a base:RunProcess } AS ?hasRunType)
  }
  FILTER(STRSTARTS(STR(?graph), "https://w3id.org/baseball/graph/game/"))
}
ORDER BY ?game ?plateAppearance ?resolution ?act
