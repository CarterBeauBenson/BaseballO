PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>

# Existing-term evidence inventory, not a completeness certificate. Every row
# keeps its promoted graph and world-side referent. No provider event labels,
# inferred continuity, inferred causation, or missing-row negative assertions.
SELECT DISTINCT ?graph ?game ?kind ?entity ?player ?act ?roleType
                ?reviewRecord ?original ?operative ?disposition ?decision
                ?trajectory ?episode ?trajectoryHalf ?trajectoryInterval
                ?paHalf ?paInterval ?paStartInstant ?paEndInstant
                ?paStartTimestamp ?paEndTimestamp ?paStart ?paEnd ?paOutCount ?paOutsBefore
WHERE {
  GRAPH ?graph {
    ?game a base:BaseballGame .
    {
      ?entity a base:PlateAppearance ;
          obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .
      # Actual batting participation, not official statistical PA assignment.
      # Keep unassigned and multiply assigned PAs visible for reconciliation.
      OPTIONAL {
        ?act a base:BatterAct ; obo:BFO_0000132 ?entity ; obo:BFO_0000055 ?battingRole .
        ?battingRole a base:BatterRole ; obo:BFO_0000197 ?player .
      }
      OPTIONAL { ?entity obo:BFO_0000132 ?paHalf . ?paHalf a base:HalfInning . }
      OPTIONAL {
        ?entity obo:BFO_0000199 ?paInterval . ?paInterval a obo:BFO_0000038 .
        OPTIONAL {
          ?paInterval obo:BFO_0000222 ?paStartInstant .
          ?paStartInstant a base:BaseballEventTemporalInstant .
          ?paStartTimestamp a base:BaseballTimestampICE ; cco:ont00001916 ?paStartInstant ;
              cco:ont00001808 ?entity ; cco:ont00001767 ?paStart .
        }
        OPTIONAL {
          ?paInterval obo:BFO_0000224 ?paEndInstant .
          ?paEndInstant a base:BaseballEventTemporalInstant .
          ?paEndTimestamp a base:BaseballTimestampICE ; cco:ont00001916 ?paEndInstant ;
              cco:ont00001808 ?entity ; cco:ont00001767 ?paEnd .
        }
      }
      OPTIONAL {
        ?paOutCount a base:PlateAppearanceStartOutCountICE ; cco:ont00001808 ?entity ;
            cco:ont00001773 ?paOutsBefore .
      }
      BIND("plate_appearance" AS ?kind)
    } UNION {
      VALUES (?entityType ?kind) {
        (base:BattedBallPlayProcess "batted_play") (base:RunProcess "run")
      }
      ?entity a ?entityType ; obo:BFO_0000132+ ?game .
    } UNION {
      ?act obo:BFO_0000132+ ?game ; obo:BFO_0000055 ?role .
      ?role obo:BFO_0000197 ?player ; a ?roleType .
      VALUES ?roleType { base:BatterRole base:BaserunnerRole base:PitcherRole base:FielderRole }
      BIND(?player AS ?entity)
      BIND("player_game" AS ?kind)
    } UNION {
      ?trajectory a obo:BFO_0000015 ; obo:BFO_0000117 ?episode ;
          obo:BFO_0000057 ?player ; obo:BFO_0000132 ?trajectoryHalf ;
          obo:BFO_0000199 ?trajectoryInterval .
      ?trajectoryHalf a base:HalfInning ; obo:BFO_0000132/obo:BFO_0000132 ?game .
      FILTER(REGEX(STR(?trajectory), "^https://baseballontology[.]org/data/game/[0-9]+/runner-trajectory/[^/]+$"))
      BIND(?trajectory AS ?entity)
      BIND("runner_history" AS ?kind)
    } UNION {
      ?entity a base:BaseballReplayReviewAct .
      ?reviewRecord a base:BaseballReplayReviewEventRecord ;
        cco:ont00001808 ?entity .
      {
        # Existing play-level reviews are scoped by the final result judgment.
        ?reviewRecord cco:ont00001808 ?resultJudgment .
        ?resultJudgment obo:BFO_0000132 ?result .
        ?result a base:BaseballInstitutionalProcess ; obo:BFO_0000132 ?reviewPA .
      } UNION {
        # M2's operative pitch judgment is itself the review. Its counted
        # ball/strike process belongs to the PA; the original process does not.
        # Match asserted source types without requiring an inference graph.
        ?entity a ?pitchReviewType ; obo:BFO_0000132 ?result .
        VALUES (?pitchReviewType ?pitchResultType) {
          (base:BallAffirmingBaseballReplayReviewAct base:BallProcess)
          (base:StrikeAffirmingBaseballReplayReviewAct base:StrikeProcess)
        }
        ?result a ?pitchResultType ; obo:BFO_0000132 ?reviewPA .
      }
      ?reviewPA a base:PlateAppearance ;
        obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .
      BIND("review" AS ?kind)
      OPTIONAL {
        ?reviewRecord a base:BaseballReplayReviewEventRecord ;
          cco:ont00001808 ?entity, ?onFieldJudgment, ?original, ?operative, ?disposition .
        ?onFieldJudgment a base:ReviewedOnFieldUmpireJudgmentAct ;
          cco:ont00001986 ?original ; obo:BFO_0000063 ?entity .
        ?entity cco:ont00001921 ?original ; cco:ont00001986 ?operative .
        ?original a base:ReviewedOnFieldBaseballDecisionICE .
        ?operative a base:BaseballReplayDecisionICE .
        ?disposition a ?dispositionType ;
          cco:ont00001816 ?entity ; cco:ont00001808 ?original, ?operative .
        VALUES (?dispositionType ?decision) {
          (base:AffirmingBaseballReplayReviewDispositionICE "affirmed")
          (base:OverturningBaseballReplayReviewDispositionICE "reversed")
        }
      }
    }
  }
  FILTER(STRSTARTS(STR(?graph), "https://w3id.org/baseball/graph/game/"))
}
