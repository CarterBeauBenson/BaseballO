PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>

# Existing-term evidence inventory, not a completeness certificate. Every row
# keeps its promoted graph and world-side referent. No provider event labels,
# inferred continuity, inferred causation, or missing-row negative assertions.
SELECT DISTINCT ?graph ?game ?kind ?entity ?player ?act ?roleType
                ?playerTeamRole ?team ?teamRole
                ?paResult ?paResultType ?paResultJudgment ?paResultDecision ?paResultRecord ?recognizedBattingResult ?batterProgressExcluded
                ?reviewRecord ?original ?operative ?disposition ?decision
                ?reviewPA ?reviewPitch ?reviewMotion ?reviewBatterAct ?affectedPlayer
                ?defensiveAct ?defensiveActType ?defensiveAgent ?defensiveRole ?defensiveNext
                ?trajectory ?episode ?trajectoryHalf ?trajectoryInterval
                ?trajectoryEndInstant ?gameEndTimestamp ?gameEnd
                ?paHalf ?paInterval ?paStartInstant ?paEndInstant
                ?paStartTimestamp ?paEndTimestamp ?paStart ?paEnd ?paOutCount ?paOutsBefore
                ?plateAppearance ?countAwardKind ?countJudgment ?countDecision ?countRule ?record ?priorPitch ?nextPitch
WHERE {
  GRAPH ?graph {
    ?game a base:BaseballGame .
    {
      ?entity a base:PlateAppearance ;
          obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .
      # Actual batting participation, not official statistical PA assignment.
      # Keep unassigned and multiply assigned PAs visible for reconciliation.
      OPTIONAL {
        ?act a base:BatterAct ; obo:BFO_0000132 ?entity ; obo:BFO_0000055 ?battingRole .
        ?battingRole a base:BatterRole ; obo:BFO_0000197 ?player .
      }
      # Inventory the existing adjudicated result. These bindings do not by
      # themselves declare statistical PA eligibility or player qualification.
      OPTIONAL {
        ?paResult a base:BaseballInstitutionalProcess, ?paResultType ; obo:BFO_0000132 ?entity .
        ?paResultJudgment a base:BaseballAdjudicationAct ; obo:BFO_0000132 ?paResult ;
            cco:ont00001986 ?paResultDecision .
        ?paResultDecision a base:BaseballDecisionICE ; cco:ont00001808 ?paResult .
        ?paResultRecord a base:BaseballEventRecord ;
            cco:ont00001808 ?paResult, ?paResultJudgment, ?paResultDecision .
        # B1 classification over existing result types. This becomes official
        # qualification ONLY when the separate source/RDF proof is admitted.
        BIND(?paResultType IN (
          base:SingleProcess, base:DoubleProcess, base:TripleProcess, base:HomeRunProcess,
          base:BattedBallOutProcess, base:ForceOutProcess, base:GroundedIntoDoublePlayProcess,
          base:DoublePlayProcess, base:SacrificeFlyProcess, base:SacrificeBuntProcess,
          base:StrikeoutProcess, base:WalkProcess, base:HitByPitchProcess,
          base:FieldersChoiceProcess, base:ErrorProcess, base:InterferenceProcess
        ) AS ?recognizedBattingResult)
        # Owning MLB contract: this InterferenceProcess result is catcher_interf.
        # Preserve official eligibility and actual outcomes; exclude positive
        # batting credit, including Empty Game positive-contribution counting.
        BIND(?paResultType IN (base:ErrorProcess, base:FieldersChoiceProcess,
          base:InterferenceProcess) AS ?batterProgressExcluded)
      }
      OPTIONAL { ?entity obo:BFO_0000132 ?paHalf . ?paHalf a base:HalfInning . }
      OPTIONAL {
        ?entity obo:BFO_0000199 ?paInterval . ?paInterval a obo:BFO_0000038 .
        OPTIONAL {
          ?paInterval obo:BFO_0000222 ?paStartInstant .
          ?paStartInstant a base:BaseballEventTemporalInstant .
          ?paStartTimestamp a base:BaseballTimestampICE ; cco:ont00001916 ?paStartInstant ;
              cco:ont00001808 ?entity ; cco:ont00001767 ?paStart .
        }
        OPTIONAL {
          ?paInterval obo:BFO_0000224 ?paEndInstant .
          ?paEndInstant a base:BaseballEventTemporalInstant .
          ?paEndTimestamp a base:BaseballTimestampICE ; cco:ont00001916 ?paEndInstant ;
              cco:ont00001808 ?entity ; cco:ont00001767 ?paEnd .
        }
      }
      OPTIONAL {
        ?paOutCount a base:PlateAppearanceStartOutCountICE ; cco:ont00001808 ?entity ;
            cco:ont00001773 ?paOutsBefore .
      }
      BIND("plate_appearance" AS ?kind)
    } UNION {
      VALUES (?entityType ?kind) {
        (base:BattedBallPlayProcess "batted_play") (base:RunProcess "run")
      }
      ?entity a ?entityType ; obo:BFO_0000132+ ?game .
      OPTIONAL {
        ?entity a base:BattedBallPlayProcess ; obo:BFO_0000132+ ?plateAppearance .
        ?plateAppearance a base:PlateAppearance .
      }
      OPTIONAL {
        ?entity a base:BattedBallPlayProcess .
        VALUES ?defensiveActType { base:FieldingAttemptAct base:CatchAttemptAct base:ThrowAct base:TagAttemptAct }
        ?defensiveAct a ?defensiveActType ; obo:BFO_0000132+ ?entity .
        OPTIONAL {
          ?defensiveAct cco:ont00001833 ?defensiveAgent .
          OPTIONAL {
            ?defensiveAct obo:BFO_0000055 ?defensiveRole .
            ?defensiveRole a base:FielderRole ; obo:BFO_0000197 ?defensiveAgent .
          }
        }
        OPTIONAL { ?defensiveAct obo:BFO_0000063 ?defensiveNext . }
      }
    } UNION {
      ?act obo:BFO_0000132+ ?game ; obo:BFO_0000055 ?role .
      ?role obo:BFO_0000197 ?player ; a ?roleType .
      VALUES ?roleType { base:BatterRole base:BaserunnerRole base:PitcherRole base:FielderRole }
      BIND(?player AS ?entity)
      BIND("player_game" AS ?kind)
    } UNION {
      # Game-specific assertions; do not infer historical membership from
      # adjacent games, or equate an unbounded role stasis with realization.
      ?game obo:BFO_0000055 ?playerTeamRole .
      ?playerTeamRole a base:PlayerRole ; obo:BFO_0000197 ?player .
      OPTIONAL { ?playerTeamRole cco:ont00001992 ?team . }
      OPTIONAL {
        ?playerTeamRole cco:ont00001992 ?team .
        ?teamRole a ?teamRoleType ; obo:BFO_0000197 ?team ; obo:BFO_0000054 ?game .
        VALUES ?teamRoleType { base:HomeTeamRole base:AwayTeamRole }
      }
      BIND(?playerTeamRole AS ?entity)
      BIND("player_team_game" AS ?kind)
    } UNION {
      ?trajectory a obo:BFO_0000015 ; obo:BFO_0000117 ?episode ;
          obo:BFO_0000057 ?player ; obo:BFO_0000132 ?trajectoryHalf ;
          obo:BFO_0000199 ?trajectoryInterval .
      ?trajectoryHalf a base:HalfInning ; obo:BFO_0000132/obo:BFO_0000132 ?game .
      OPTIONAL {
        ?trajectoryInterval obo:BFO_0000224 ?trajectoryEndInstant .
        ?game obo:BFO_0000199/obo:BFO_0000224 ?trajectoryEndInstant .
        ?gameEndTimestamp a base:BaseballTimestampICE ; cco:ont00001916 ?trajectoryEndInstant ;
            cco:ont00001808 ?game ; cco:ont00001767 ?gameEnd .
      }
      FILTER(REGEX(STR(?trajectory), "^https://baseballontology[.]org/data/game/[0-9]+/runner-trajectory/[^/]+$"))
      BIND(?trajectory AS ?entity)
      BIND("runner_history" AS ?kind)
    } UNION {
      # Q5: source-owned award records distinguish counted non-pitch processes
      # from delivered pitches. No count-state literal or Pitch Act is invented.
      ?record a base:BaseballEventRecord ; cco:ont00001808 ?entity, ?countJudgment, ?countDecision .
      FILTER(CONTAINS(STR(?record), "/event-record/count-award/"))
      VALUES (?countType ?countAwardKind) { (base:BallProcess "ball") (base:StrikeProcess "strike") }
      ?entity a ?countType ; obo:BFO_0000132 ?countPA ; obo:BFO_0000117 ?countJudgment .
      ?countPA a base:PlateAppearance ; obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .
      ?countJudgment obo:BFO_0000132 ?entity ; cco:ont00001986 ?countDecision ; cco:ont00001921 ?countRule .
      ?countDecision cco:ont00001808 ?entity .
      BIND(?countPA AS ?plateAppearance)
      OPTIONAL { ?priorPitch a base:PitchAct ; obo:BFO_0000063 ?entity ; obo:BFO_0000132 ?countPA . }
      OPTIONAL { ?entity obo:BFO_0000063 ?nextPitch . ?nextPitch a base:PitchAct ; obo:BFO_0000132 ?countPA . }
      BIND("automatic_count_award" AS ?kind)
    } UNION {
      ?entity a base:BaseballReplayReviewAct .
      ?reviewRecord a base:BaseballReplayReviewEventRecord ;
        cco:ont00001808 ?entity .
      {
        # Existing play-level reviews are scoped by the final result judgment.
        ?reviewRecord cco:ont00001808 ?resultJudgment .
        ?resultJudgment obo:BFO_0000132 ?result .
        ?result a base:BaseballInstitutionalProcess ; obo:BFO_0000132 ?reviewPA .
      } UNION {
        # M2's operative pitch judgment is itself the review. Its counted
        # ball/strike process belongs to the PA; the original process does not.
        # Match asserted source types without requiring an inference graph.
        ?entity a ?pitchReviewType ; obo:BFO_0000132 ?result .
        VALUES (?pitchReviewType ?pitchResultType) {
          (base:BallAffirmingBaseballReplayReviewAct base:BallProcess)
          (base:StrikeAffirmingBaseballReplayReviewAct base:StrikeProcess)
        }
        ?result a ?pitchResultType ; obo:BFO_0000132 ?reviewPA .
      }
      ?reviewPA a base:PlateAppearance ;
        obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .
      BIND("review" AS ?kind)
      OPTIONAL {
        ?reviewRecord a base:BaseballReplayReviewEventRecord ;
          cco:ont00001808 ?entity, ?onFieldJudgment, ?original, ?operative, ?disposition .
        ?onFieldJudgment a base:ReviewedOnFieldUmpireJudgmentAct ;
          cco:ont00001986 ?original ; obo:BFO_0000063 ?entity .
        ?entity cco:ont00001921 ?original ; cco:ont00001986 ?operative .
        ?original a base:ReviewedOnFieldBaseballDecisionICE .
        ?operative a base:BaseballReplayDecisionICE .
        ?disposition a ?dispositionType ;
          cco:ont00001816 ?entity ; cco:ont00001808 ?original, ?operative .
        VALUES (?dispositionType ?decision) {
          (base:AffirmingBaseballReplayReviewDispositionICE "affirmed")
          (base:OverturningBaseballReplayReviewDispositionICE "reversed")
        }
        OPTIONAL {
          # Accepted M2 CQ7: identify the affected batter through the common
          # reviewed motion, its exact pitch and actual batting participation.
          # This is subject attribution, not review mechanism/eligibility.
          ?original cco:ont00001808 ?reviewMotion .
          ?operative cco:ont00001808 ?reviewMotion .
          ?reviewMotion a base:PitchBallMotionProcess ; obo:BFO_0000132 ?reviewPA ;
              obo:BFO_0000062 ?reviewPitch .
          ?reviewPitch a base:PitchAct ; obo:BFO_0000132 ?reviewPA .
          ?reviewRecord cco:ont00001808 ?reviewPitch .
          OPTIONAL {
            # The existing graph has no pitch-to-taking-act relation. A PA
            # with several batting stints therefore remains unassigned here.
            ?reviewBatterAct a base:BatterAct ; obo:BFO_0000132 ?reviewPA ;
                obo:BFO_0000057 ?affectedPlayer ; obo:BFO_0000055 ?reviewBatterRole .
            ?reviewBatterRole a base:BatterRole ; obo:BFO_0000197 ?affectedPlayer .
            FILTER NOT EXISTS {
              ?otherBatterAct a base:BatterAct ; obo:BFO_0000132 ?reviewPA .
              FILTER(?otherBatterAct != ?reviewBatterAct)
            }
            FILTER NOT EXISTS {
              ?reviewBatterAct obo:BFO_0000055 ?otherBatterRole .
              ?otherBatterRole a base:BatterRole ; obo:BFO_0000197 ?otherBatter .
              FILTER(?otherBatter != ?affectedPlayer)
            }
          }
        }
      }
    }
  }
  FILTER(STRSTARTS(STR(?graph), "https://w3id.org/baseball/graph/game/"))
}
