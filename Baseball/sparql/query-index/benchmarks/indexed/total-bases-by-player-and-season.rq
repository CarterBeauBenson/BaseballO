PREFIX base: <https://baseballontology.org/>
PREFIX idx: <https://w3id.org/baseball/query-index/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?season ?player ?playerLabel (SUM(?bases) AS ?totalBases)
WHERE {
  GRAPH ?graph {
    ?result a idx:HitFact ;
            idx:agent ?player ;
            idx:game ?game ;
            idx:hitType ?hitClass .
    ?game a idx:GameFact ;
          idx:season ?season .
    ?player rdfs:label ?playerLabel .
    VALUES (?hitClass ?bases) {
      (base:SingleProcess 1)
      (base:DoubleProcess 2)
      (base:TripleProcess 3)
      (base:HomeRunProcess 4)
    }
  }
}
GROUP BY ?season ?player ?playerLabel
ORDER BY ?season DESC(?totalBases) LCASE(STR(?playerLabel))
