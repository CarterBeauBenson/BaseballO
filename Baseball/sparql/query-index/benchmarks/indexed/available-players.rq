PREFIX idx: <https://w3id.org/baseball/query-index/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?player ?playerLabel
WHERE {
  GRAPH ?graph {
    ?plateAppearance a idx:PlateAppearanceFact ;
                     idx:agent ?player .
    ?player rdfs:label ?playerLabel .
  }
}
ORDER BY LCASE(STR(?playerLabel))
