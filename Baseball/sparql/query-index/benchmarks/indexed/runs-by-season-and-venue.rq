PREFIX base: <https://baseballontology.org/>
PREFIX idx: <https://w3id.org/baseball/query-index/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?season ?venue ?venueLabel
       (COUNT(DISTINCT ?run) AS ?runs)
       (COUNT(DISTINCT ?game) AS ?gamesWithRuns)
WHERE {
  GRAPH ?graph {
    ?run a idx:RunnerResolutionFact ;
         idx:resolutionClass base:RunProcess ;
         idx:game ?game .
    ?game a idx:GameFact ;
          idx:season ?season ;
          idx:venue ?venue .
    ?venue rdfs:label ?venueLabel .
  }
}
GROUP BY ?season ?venue ?venueLabel
ORDER BY ?season DESC(?runs) LCASE(STR(?venueLabel))
