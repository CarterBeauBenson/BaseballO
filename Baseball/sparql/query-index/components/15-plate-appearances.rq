PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX idx: <https://w3id.org/baseball/query-index/>
PREFIX obo: <http://purl.obolibrary.org/obo/>

CONSTRUCT {
  ?plateAppearance a idx:PlateAppearanceFact ;
      idx:game ?game ;
      idx:agent ?player ;
      idx:derivedFrom ?batterAct .
  # Keep each accepted Batter Act's actor attached to that act. The PA is
  # still one fact when a substitution produces several actual Batter Acts.
  ?batterAct idx:agent ?player ;
      idx:plateAppearance ?plateAppearance ;
      idx:game ?game .
}
WHERE {
  VALUES (?sourceGraph ?game) {
    (<urn:baseball:query-index:source-graph> <urn:baseball:query-index:game>)
  }
  GRAPH ?sourceGraph {
    ?batterAct a base:BatterAct ;
        obo:BFO_0000132 ?plateAppearance ;
        obo:BFO_0000057 ?player .
    ?player a cco:ont00001262 .
    ?plateAppearance a base:PlateAppearance ;
        obo:BFO_0000132/obo:BFO_0000132/obo:BFO_0000132 ?game .
  }
}
