PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX idx: <https://w3id.org/baseball/query-index/>
PREFIX obo: <http://purl.obolibrary.org/obo/>

CONSTRUCT {
  ?resolution a idx:RunnerResolutionFact ;
      idx:agent ?player ;
      idx:game ?game ;
      idx:resolutionClass ?resolutionClass ;
      idx:sourceEventType ?eventType ;
      idx:derivedFrom ?record, ?judgment .
}
WHERE {
  VALUES (?sourceGraph ?game) {
    (<urn:baseball:query-index:source-graph> <urn:baseball:query-index:game>)
  }
  GRAPH ?sourceGraph {
    ?record a base:BaseballEventRecord ;
        cco:ont00001808 ?resolution ;
        dcterms:identifier ?eventType .
    ?resolution a base:RunnerResolutionProcess, ?resolutionClass ;
        obo:BFO_0000132 ?game ;
        obo:BFO_0000057 ?player ;
        obo:BFO_0000117 ?judgment .
    ?player a cco:ont00001262 .
    ?judgment a ?judgmentClass .
    VALUES (?resolutionClass ?judgmentClass) {
      (base:RunProcess base:RunJudgmentAct)
      (base:OutProcess base:OutJudgmentAct)
      (base:SafeProcess base:SafeJudgmentAct)
    }
  }
}
