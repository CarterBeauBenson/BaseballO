PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX idx: <https://w3id.org/baseball/query-index/>
PREFIX obo: <http://purl.obolibrary.org/obo/>

CONSTRUCT {
  ?game a idx:GameFact ;
      idx:season ?season ;
      idx:venue ?venue ;
      idx:gameStart ?gameStart ;
      idx:derivedFrom ?timestamp, ?field .
}
WHERE {
  VALUES (?sourceGraph ?game) {
    (<urn:baseball:query-index:source-graph> <urn:baseball:query-index:game>)
  }
  GRAPH ?sourceGraph {
    ?game a base:BaseballGame ;
        cco:ont00001918 ?field ;
        obo:BFO_0000199/obo:BFO_0000222 ?startInstant .
    ?timestamp a base:BaseballTimestampICE ;
        cco:ont00001916 ?startInstant ;
        cco:ont00001767 ?gameStart .
    ?field a base:BaseballFieldSite ;
        obo:BFO_0000171 ?venue .
    BIND(YEAR(?gameStart) AS ?season)
  }
}
