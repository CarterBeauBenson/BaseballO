PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX idx: <https://w3id.org/baseball/query-index/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Indexed pitch identity, containment, and semantic call classification,
# enriched with authoritative fielding-team context for the Explorer.
SELECT DISTINCT ?graph ?indexGraph ?game ?gameStart ?season ?venue ?venueLabel
                ?pitch ?plateAppearance ?pitcher ?pitcherLabel ?team ?teamLabel ?pitchCallCode
WHERE {
  GRAPH ?indexGraph {
    ?index a idx:QueryIndex ; idx:sourceGraph ?graph ; idx:indexedGame ?game ; idx:contractVersion "1" .
    ?game a idx:GameFact ; idx:gameStart ?gameStart ; idx:season ?season ; idx:venue ?venue .
    ?pitch a idx:PitchFact ; idx:plateAppearance ?plateAppearance ; idx:game ?game ;
           idx:agent ?pitcher ; idx:venue ?venue .
    OPTIONAL {
      ?callFact a idx:PitchCallFact ; idx:pitch ?pitch ; idx:callType ?pitchCallType .
      VALUES (?pitchCallType ?classifiedPitchCallCode) {
        (idx:Ball "B")
        (idx:CalledStrike "C")
        (idx:SwingingStrike "S")
        (idx:Foul "F")
        (idx:InPlay "X")
        (idx:HitByPitch "H")
      }
    }
    ?venue rdfs:label ?venueLabel .
    ?pitcher rdfs:label ?pitcherLabel .
  }
  GRAPH ?graph {
    ?halfInning a base:HalfInning ; obo:BFO_0000117 ?plateAppearance .
    BIND(IF(STRENDS(STR(?halfInning), "/top"), base:HomeTeamRole, base:AwayTeamRole) AS ?teamRoleClass)
    ?teamRole a ?teamRoleClass ; obo:BFO_0000197 ?team ; obo:BFO_0000054 ?game .
    ?team rdfs:label ?teamLabel .
  }
  BIND(COALESCE(?classifiedPitchCallCode, "U") AS ?pitchCallCode)
  FILTER(STRSTARTS(STR(?graph), "https://w3id.org/baseball/graph/game/"))
  FILTER(STRSTARTS(STR(?indexGraph), "https://w3id.org/baseball/graph/query-index/game/"))
}
ORDER BY ?graph ?pitch
