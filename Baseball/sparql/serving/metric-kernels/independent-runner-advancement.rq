# Generated by scripts/generate_metric_suite.py.
# Calculation on admitted SPARQL bindings; not a source-evidence admission rule.
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?key (SUM(?gain) AS ?numerator) (6 AS ?denominator)
WHERE {
  VALUES (?key ?participant ?start ?end ?terminal ?creditProgress) {
    # INPUT_ROWS
  }
  BIND(IF((?terminal="safe" || ?terminal="scored") && ?creditProgress, IF(?start<=1 && ?end>1,2,0)+IF(?start<=2 && ?end>2,3,0)+IF(?start<=3 && ?end>3,6,0), 0) AS ?gain)
}
GROUP BY ?key
