# Generated by scripts/generate_metric_suite.py.
# Calculation on admitted SPARQL bindings; not a source-evidence admission rule.
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?key ?event ?base
WHERE {
  VALUES (?key ?event ?ordinal ?base ?known ?changesState ?boundary ?historyComplete ?boundarySupported) {
    # INPUT_ROWS
  }
  VALUES (?peerKey ?peerEvent ?peerOrdinal ?peerBase ?peerKnown ?peerChangesState ?peerBoundary ?peerHistoryComplete ?peerBoundarySupported) {
    # PEER_ROWS
  }
  FILTER (?historyComplete && ?boundarySupported && ?known)
  FILTER (?base >= 1 && ?base <= 3 && ?ordinal <= ?boundary)
  FILTER (?peerKey = ?key)
  BIND(IF(?peerOrdinal <= ?boundary
    && (?peerOrdinal > ?ordinal || (?peerOrdinal = ?ordinal && ?peerEvent != ?event))
    && (!?peerKnown || ?peerChangesState), 1, 0) AS ?block)
}
GROUP BY ?key ?event ?base
HAVING (SUM(?block) = 0)
