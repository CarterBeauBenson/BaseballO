# Generated by scripts/generate_metric_suite.py.
# Calculation on admitted SPARQL bindings; not a source-evidence admission rule.
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
SELECT ?key (SUM(?lower) AS ?lower) (SUM(?tie) AS ?ties) (COUNT(?peerKey) AS ?population) (100*(2*SUM(?lower)+SUM(?tie)-1) AS ?numerator) (2*(COUNT(?peerKey)-1) AS ?denominator)
WHERE {
  VALUES (?key ?cohort ?scoreN ?scoreD) {
    # INPUT_ROWS
  }
  VALUES (?peerKey ?peerCohort ?peerScoreN ?peerScoreD) {
    # PEER_ROWS
  }
  FILTER(?cohort=?peerCohort)
  BIND(IF(?peerScoreN*?scoreD<?scoreN*?peerScoreD,1,0) AS ?lower)
  BIND(IF(?scoreN*?peerScoreD=?peerScoreN*?scoreD,1,0) AS ?tie)
}
GROUP BY ?key
