PREFIX idx: <https://w3id.org/baseball/query-index/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT DISTINCT ?graph ?indexGraph ?game ?assignment ?assignmentType ?assignee ?assigneeLabel
WHERE {
  GRAPH ?indexGraph {
    ?index a idx:QueryIndex ; idx:sourceGraph ?graph ; idx:indexedGame ?game ; idx:contractVersion "1" .
    ?assignment a idx:AssignmentFact ; idx:game ?game ; idx:assignmentType ?assignmentType ;
                idx:assignee ?assignee .
    ?assignee rdfs:label ?assigneeLabel .
  }
  FILTER(STRSTARTS(STR(?graph), "https://w3id.org/baseball/graph/game/"))
  FILTER(STRSTARTS(STR(?indexGraph), "https://w3id.org/baseball/graph/query-index/game/"))
}
ORDER BY ?graph ?assignment
