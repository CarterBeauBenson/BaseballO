{
  "artifactType": "baseballo-nifi-dashboard-sql-flow-contract",
  "contractVersion": 1,
  "rootProcessGroup": "BaseballO",
  "processGroup": "Dashboard SQL",
  "materialization": {
    "processor": "scripts/pipeline/materialize-dashboard.py",
    "schema": "serving/dashboard-schema.sql",
    "readOnlyWorkers": 1,
    "partitioning": "metric-family-and-authoritative-game-graph",
    "checkpoint": "one-transaction-per-family-game",
    "publication": "serving/dashboard-current.json",
    "schedule": "one-minute-change-check-with-one-waiting-flowfile",
    "families": ["offense", "defense", "combined", "other"],
    "familyExecution": "one-family-per-tick-round-robin-with-three-attempts-per-input-notification",
    "dependencies": ["mlb-game promoted graph pairs and existing admission proofs"]
  },
  "failurePolicy": {
    "maximumRetries": 2,
    "authoritativeRdfUnaffected": true,
    "queryIndexRdfUnaffected": true,
    "sourceLanesUnaffected": true,
    "priorFamilyProductsUnaffected": true,
    "uiAdmissionUnaffected": true
  }
}
