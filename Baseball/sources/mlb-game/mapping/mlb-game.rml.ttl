@base <https://baseballontology.org/mapping/mlb-direct> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix base: <https://baseballontology.org/> .
@prefix data: <https://baseballontology.org/data/> .

# Direct mapping over an untouched MLB /feed/live JSON document plus an isolated
# execution-context copy generated from that same document. The raw game.json
# remains byte-identical; game-context.json only exposes ancestor identifiers to
# nested pitch records because RMLMapper cannot expand parent array references.
# Templates can contain explicit root-identifier markers for the game, venue, and
# participating teams. The execution harness resolves only those markers in a temporary
# mapping copy because nested JSONPath references are relative to their logical-source record.

<#RootSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$" .

<#RootContextSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO" .

<#SeasonPhaseSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.seasonPhase" .

<#SchedulePostponementSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.schedulePostponements[*]" .

<#SchedulePostponementReasonSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.schedulePostponements[?(@.hasReason == true)]" .

<#AwayTeamSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.teams.away" .

<#HomeTeamSource> a rml:LogicalSource ;
