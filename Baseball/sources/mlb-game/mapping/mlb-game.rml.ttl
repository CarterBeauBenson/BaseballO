  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'X')]" .

