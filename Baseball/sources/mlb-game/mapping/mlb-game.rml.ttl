  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.players.*" .

<#RosterPlayerSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.boxscore.teams.*.players.*" .

<#CatcherPlayerSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.players.*[?(@.primaryPosition.code == '2')]" .

<#VenueSource> a rml:LogicalSource ;
  rml:source "game.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.gameData.venue" .

<#PlaySource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@._baseballO.hasPlateAppearanceStructure == true)]" .

<#ContextPlaySource> a rml:LogicalSource ;
