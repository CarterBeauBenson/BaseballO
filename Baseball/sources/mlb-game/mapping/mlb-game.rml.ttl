<#FoulSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'F')]" .

<#AllFoulBallSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'F' || @.isPitch == true && @.details.call.code == 'L')]" .

# The event-local feed cannot distinguish every second-strike foul from a
# two-strike foul. This conservative source emits only unambiguous first
# counted fouls; the remaining ambiguity is documented as a source gap.
<#CountedFoulSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'F' && @.count.strikes == 1)]" .

<#FoulTipSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'T')]" .

<#AllFoulTipSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @.details.call.code == 'T' || @.isPitch == true && @.details.call.code == 'O')]" .

