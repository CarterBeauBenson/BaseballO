#################################################################

<#BallProcessAdjudicationOverlayMap> a rr:TriplesMap ;
  rml:logicalSource <#AllBallSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/process/ball/{playId}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/ball/{playId}" ; rr:termType rr:IRI ] ] .

