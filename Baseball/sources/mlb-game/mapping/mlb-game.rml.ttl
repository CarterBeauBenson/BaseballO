  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'S' || @.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'W')]" .

