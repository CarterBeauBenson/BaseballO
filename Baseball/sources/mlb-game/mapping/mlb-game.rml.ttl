  rr:subjectMap [ rr:constant <https://baseballontology.org/data/rule/passed-ball> ; rr:termType rr:IRI ; rr:class base:PassedBallRule ] .

<#WildPitchProcessMap> a rr:TriplesMap ;
  rml:logicalSource <#WildPitchRunnerSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/process/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ; rr:class base:WildPitchProcess ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000132 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{_baseballO.atBatIndex}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001920 ; rr:objectMap [ rr:constant <https://baseballontology.org/data/rule/wild-pitch> ] ] .

<#WildPitchJudgmentMap> a rr:TriplesMap ;
  rml:logicalSource <#WildPitchRunnerSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ; rr:class base:WildPitchJudgmentAct ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000132 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/process/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000057 ; rr:objectMap [ rr:template "https://baseballontology.org/data/person/{$.gameData.officialScorer.id}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000055 ; rr:objectMap [ rr:template "https://baseballontology.org/data/person/{$.gameData.officialScorer.id}/role/official-scorer" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001920 ; rr:objectMap [ rr:constant <https://baseballontology.org/data/rule/wild-pitch> ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001986 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/decision/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ] ] .

<#WildPitchDecisionMap> a rr:TriplesMap ;
  rml:logicalSource <#WildPitchRunnerSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/decision/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ; rr:class base:WildPitchDecisionICE ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001816 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/process/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ] ] .

<#WildPitchRecordMap> a rr:TriplesMap ;
  rml:logicalSource <#WildPitchRunnerSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-record/{_baseballO.atBatIndex}/{_baseballO.runnerIndex}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/process/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/decision/wild-pitch/{_baseballO.eventPlayId}" ; rr:termType rr:IRI ] ] .

<#WildPitchRuleMap> a rr:TriplesMap ;
  rml:logicalSource <#RootSource> ;
  rr:subjectMap [ rr:constant <https://baseballontology.org/data/rule/wild-pitch> ; rr:termType rr:IRI ; rr:class base:WildPitchRule ] .

#################################################################
# Uncaught-third-strike composite and unresolved MLB runner record
#################################################################

<#UncaughtThirdStrikeProcessMap> a rr:TriplesMap ;
  rml:logicalSource <#UncaughtThirdStrikePlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/uncaught-third-strike" ; rr:termType rr:IRI ; rr:class base:UncaughtThirdStrikeProcess ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000132 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/result" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/uncaught-third-strike/{about.atBatIndex}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001920 ; rr:objectMap [ rr:constant <https://baseballontology.org/data/rule/strike> ] ] .

<#UncaughtThirdStrikeJudgmentMap> a rr:TriplesMap ;
  rml:logicalSource <#UncaughtThirdStrikePlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/uncaught-third-strike/{about.atBatIndex}" ; rr:termType rr:IRI ; rr:class base:UmpireJudgmentAct ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000132 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/uncaught-third-strike" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000057 ; rr:objectMap [ rr:template "https://baseballontology.org/data/person/{$.homePlateUmpire.id}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000055 ; rr:objectMap [ rr:template "https://baseballontology.org/data/person/{$.homePlateUmpire.id}/role/umpire" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001920 ; rr:objectMap [ rr:constant <https://baseballontology.org/data/rule/strike> ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001986 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/decision/uncaught-third-strike/{about.atBatIndex}" ; rr:termType rr:IRI ] ] .

<#UncaughtThirdStrikeDecisionMap> a rr:TriplesMap ;
  rml:logicalSource <#UncaughtThirdStrikePlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/decision/uncaught-third-strike/{about.atBatIndex}" ; rr:termType rr:IRI ; rr:class base:BaseballDecisionICE ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001816 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/uncaught-third-strike/{about.atBatIndex}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/uncaught-third-strike" ; rr:termType rr:IRI ] ] .

<#UncaughtThirdStrikeResultRecordMap> a rr:TriplesMap ;
  rml:logicalSource <#UncaughtThirdStrikePlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/event-record/result" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/uncaught-third-strike" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/judgment/uncaught-third-strike/{about.atBatIndex}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/decision/uncaught-third-strike/{about.atBatIndex}" ; rr:termType rr:IRI ] ] .

<#UncaughtThirdStrikePlaceholderRecordMap> a rr:TriplesMap ;
  rml:logicalSource <#UncaughtThirdStrikePlaceholderSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-record/{_baseballO.atBatIndex}/{_baseballO.runnerIndex}" ; rr:termType rr:IRI ; rr:class base:BaseballEventRecord ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{_baseballO.atBatIndex}/uncaught-third-strike" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001765 ; rr:objectMap [ rml:reference "details.event" ] ] .

#################################################################
# Explicit parent-to-child containment complements child part-of
#################################################################

<#GameInningContainmentMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/inning/{about.inning}" ; rr:termType rr:IRI ] ] .

<#InningHalfInningContainmentMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/inning/{about.inning}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/inning/{about.inning}/{about.halfInning}" ; rr:termType rr:IRI ] ] .

<#HalfInningPlateAppearanceContainmentMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/inning/{about.inning}/{about.halfInning}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}" ; rr:termType rr:IRI ] ] .

<#PlateAppearanceCoreContainmentMap> a rr:TriplesMap ;
  rml:logicalSource <#PlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/batter-act" ; rr:termType rr:IRI ] ] .

<#PlateAppearanceResultContainmentMap> a rr:TriplesMap ;
  rml:logicalSource <#CompletedPlaySource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{about.atBatIndex}/result" ; rr:termType rr:IRI ] ] .

#################################################################
# Institutional runner destination artifacts
#################################################################

<#HomePlateArtifactMap> a rr:TriplesMap ;
  rml:logicalSource <#RootSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/artifact/home-plate" ; rr:termType rr:IRI ; rr:class base:HomePlate ] .

<#ReachedBaseArtifactMap> a rr:TriplesMap ;
  rml:logicalSource <#RunnerReachSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/artifact/base/{movement.end}" ; rr:termType rr:IRI ; rr:class base:Base ] .

<#AdvancedToBaseArtifactMap> a rr:TriplesMap ;
  rml:logicalSource <#RunnerAdvanceSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/artifact/base/{movement.end}" ; rr:termType rr:IRI ; rr:class base:Base ] .

<#RunnerEpisodeSource> a rml:LogicalSource ; rml:source "game-context.json" ; rml:referenceFormulation ql:JSONPath ; rml:iterator "$.liveData.plays.allPlays[*]._baseballO.runnerEpisodes[*]" .

<#SafeDecisionDestinationSource> a rml:LogicalSource ; rml:source "game-context.json" ; rml:referenceFormulation ql:JSONPath ; rml:iterator "$.liveData.plays.allPlays[*]._baseballO.safeDecisionDestinations[*]" .

<#RunnerEpisodeMap> a rr:TriplesMap ;
  rml:logicalSource <#RunnerEpisodeSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-episode/{atBatIndex}/{runnerIndex}" ; rr:termType rr:IRI ; rr:class base:RunnerResolutionEpisode ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-act/movement/{atBatIndex}/{runnerIndex}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000117 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-resolution/{resolutionKind}/{atBatIndex}/{runnerIndex}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate obo:BFO_0000132 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/plate-appearance/{atBatIndex}" ; rr:termType rr:IRI ] ] .

<#RunnerEpisodeAgentMap> a rr:TriplesMap ;
  rml:logicalSource <#RunnerEpisodeSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-act/movement/{atBatIndex}/{runnerIndex}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001833 ; rr:objectMap [ rr:template "https://baseballontology.org/data/player/{runnerId}" ; rr:termType rr:IRI ] ] .

<#RunnerEpisodeRecordMap> a rr:TriplesMap ;
  rml:logicalSource <#RunnerEpisodeSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-record/{atBatIndex}/{runnerIndex}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-episode/{atBatIndex}/{runnerIndex}" ; rr:termType rr:IRI ] ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/runner-act/movement/{atBatIndex}/{runnerIndex}" ; rr:termType rr:IRI ] ] .

<#SafeDecisionDestinationMap> a rr:TriplesMap ;
  rml:logicalSource <#SafeDecisionDestinationSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/game/{$.gamePk}/decision/safe/{atBatIndex}/{runnerIndex}" ; rr:termType rr:IRI ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001808 ; rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/artifact/base/{baseCode}" ; rr:termType rr:IRI ] ] .

<#SafeDestinationIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#SafeDecisionDestinationSource> ;
  rr:subjectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/artifact/base/{baseCode}/identifier/source-base-code" ; rr:termType rr:IRI ; rr:class cco:ont00000649 ] ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001916 ; rr:objectMap [ rr:template "https://baseballontology.org/data/venue/{$.gameData.venue.id}/artifact/base/{baseCode}" ; rr:termType rr:IRI ] ]  ;
  rr:predicateObjectMap [ rr:predicate cco:ont00001765 ; rr:objectMap [ rml:reference "baseCode" ] ] .
