  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].runners[?(@.movement.isOut == false && @._baseballO.endsAtScore == true && @._baseballO.hasSupportedStartBase == true)]" .

