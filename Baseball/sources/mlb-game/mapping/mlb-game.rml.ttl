<#SwingBatSource> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[*].playEvents[?(@.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'S' || @.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'W' || @.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'F' || @.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'T' || @.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'X' || @.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'D' || @.isPitch == true && @._baseballO.isBuntAttempt == false && @.details.call.code == 'E')]" .

<#Result_home_run_Source> a rml:LogicalSource ;
  rml:source "game-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.liveData.plays.allPlays[?(@._baseballO.hasCompletedPlateAppearanceResult == true && @.result.eventType == 'home_run')]" .

