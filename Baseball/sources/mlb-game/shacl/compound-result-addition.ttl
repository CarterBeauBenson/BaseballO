@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix base: <https://baseballontology.org/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix obo: <http://purl.obolibrary.org/obo/> .

<urn:baseballo:compound-result-addition> a sh:NodeShape ;
  sh:targetNode <__RESULT__> ; sh:class base:DoublePlayProcess ;
  sh:property [ sh:path cco:ont00001777 ; sh:minCount 2 ; sh:maxCount 2 ; sh:class base:OutProcess ] ;
  sh:sparql [ sh:message "Compound result and its two pre-existing out participants must reconcile" ;
    sh:select """
PREFIX base: <https://baseballontology.org/>
PREFIX cco: <https://www.commoncoreontologies.org/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
SELECT $this WHERE {
  { FILTER NOT EXISTS {
    $this a base:BaseballInstitutionalProcess ; obo:BFO_0000132 <__PA__> ; obo:BFO_0000117 ?judgment .
    <__PA__> a base:PlateAppearance .
    ?judgment a base:BaseballAdjudicationAct ; cco:ont00001986 ?decision .
    ?decision a base:BaseballDecisionICE ; cco:ont00001808 $this .
    ?record a base:BaseballEventRecord ; cco:ont00001808 $this, ?judgment, ?decision .
  } }
  UNION {
    { __PARTS__ }
    FILTER NOT EXISTS {
      $this cco:ont00001777 ?out .
      ?out a base:OutProcess, base:RunnerResolutionProcess ; obo:BFO_0000132 <__PA__> ;
        obo:BFO_0000057 ?player ; obo:BFO_0000117 ?outJudgment .
      ?outJudgment a base:OutJudgmentAct ; cco:ont00001986 ?outDecision .
      ?outDecision a base:OutDecisionICE ; cco:ont00001808 ?out .
      ?outRecord a base:BaseballEventRecord ; cco:ont00001808 ?out, ?outJudgment, ?outDecision .
    }
  }
}
""" ] .
