    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "selector" ; rr:datatype xsd:string ]
  ] .

<#DistanceQualityMap> a rr:TriplesMap ;
  rml:logicalSource <#DimensionSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{selector}/{responseSha256}/distance" ;
    rr:termType rr:IRI ;
