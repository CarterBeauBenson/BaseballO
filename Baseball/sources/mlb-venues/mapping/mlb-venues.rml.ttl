  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000178 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{responseSha256}/origin" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000178 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{selector}/{responseSha256}/boundary-point" ;
      rr:termType rr:IRI
    ]
  ] .

<#OriginFiatPointMap> a rr:TriplesMap ;
