      rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{selector}/{responseSha256}/distance" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001863 ;
    rr:objectMap [
      rr:constant cco:ont00001714 ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001769 ;
    rr:objectMap [ rml:reference "decimalValue" ; rr:datatype xsd:decimal ]
  ] .


#################################################################
# Coordinates, capacity, playing surface, and roof
#################################################################

<#VenueReferencePointMap> a rr:TriplesMap ;
  rml:logicalSource <#CoordinateSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/reference-point/default" ;
    rr:termType rr:IRI ;
    rr:class base:BaseballVenueReferencePoint
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000176 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}" ;
      rr:termType rr:IRI
    ]
  ] .

<#CoordinateInformationMap> a rr:TriplesMap ;
  rml:logicalSource <#CoordinateSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/coordinates/default/{requestedSeason}/{responseSha256}" ;
    rr:termType rr:IRI ;
    rr:class cco:ont00000686
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/reference-point/default" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001913 ;
    rr:objectMap [ rr:constant cco:ont00001630 ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001766 ;
    rr:objectMap [ rml:reference "latitude" ; rr:datatype xsd:decimal ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001764 ;
    rr:objectMap [ rml:reference "longitude" ; rr:datatype xsd:decimal ]
  ] .

<#ResponseCoordinatePartMap> a rr:TriplesMap ;
  rml:logicalSource <#CoordinateSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue-response/{venueId}/{requestedSeason}/{responseSha256}" ;
    rr:termType rr:IRI
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000178 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/coordinates/default/{requestedSeason}/{responseSha256}" ;
      rr:termType rr:IRI
    ]
  ] .

