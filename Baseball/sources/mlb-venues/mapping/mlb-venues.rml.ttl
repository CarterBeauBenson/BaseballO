      rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{selector}/{responseSha256}/boundary-point" ;
      rr:termType rr:IRI
    ]
  ] .

<#DimensionMeasurementMap> a rr:TriplesMap ;
  rml:logicalSource <#DimensionSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{selector}/{responseSha256}/measurement" ;
    rr:termType rr:IRI ;
    rr:class cco:ont00001163
  ] ;
  rr:predicateObjectMap [
