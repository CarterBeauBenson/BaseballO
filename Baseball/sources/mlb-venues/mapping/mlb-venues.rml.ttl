@base <https://baseballontology.org/mapping/mlb-venues> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix base: <https://baseballontology.org/> .

# This mapping reads only the transient execution context produced from an MLB
# venues response by prepare-context.py. The helper context supplies validated
# identity tokens and a repeated dimension record because RMLMapper does not
# expose parent JSONPath records from nested array iterators. Semantic meaning
# remains here: the context builder does not assert RDF types or relations.

<#VenueSource> a rml:LogicalSource ;
  rml:source "venue-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.venueRecords[*]" .

<#NameSource> a rml:LogicalSource ;
  rml:source "venue-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.nameRecords[*]" .

<#DimensionSource> a rml:LogicalSource ;
  rml:source "venue-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.dimensionRecords[*]" .

<#CoordinateSource> a rml:LogicalSource ;
  rml:source "venue-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.coordinateRecords[*]" .

<#CapacitySource> a rml:LogicalSource ;
  rml:source "venue-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.capacityRecords[*]" .

<#SurfaceSource> a rml:LogicalSource ;
  rml:source "venue-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.surfaceRecords[*]" .

<#RoofSource> a rml:LogicalSource ;
  rml:source "venue-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.roofRecords[*]" .

<#OpenRoofSource> a rml:LogicalSource ;
  rml:source "venue-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$._baseballO.openRoofRecords[*]" .

<#VenueResponseMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue-response/{venueId}/{requestedSeason}/{responseSha256}" ;
    rr:termType rr:IRI ;
    rr:class cco:ont00000853
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001808 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001808 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000178 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/identifier/mlb-venue-id" ;
      rr:termType rr:IRI
    ]
  ] .

<#VenueMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}" ;
    rr:termType rr:IRI ;
    rr:class base:BaseballVenue
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000196 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/hosting-function" ;
      rr:termType rr:IRI
    ]
  ] .

<#VenueIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/identifier/mlb-venue-id" ;
    rr:termType rr:IRI ;
    rr:class cco:ont00000649
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001912 ;
    rr:objectMap [
      rr:constant <https://baseballontology.org/data/reference-system/mlb-venue-identifiers> ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "venueId" ; rr:datatype xsd:string ]
  ] .

<#VenueNameMap> a rr:TriplesMap ;
  rml:logicalSource <#NameSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/name/mlb-official/{nameLexicalSha256}" ;
    rr:termType rr:IRI ;
    rr:class cco:ont00001014
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "name" ; rr:datatype xsd:string ]
  ] .

<#ResponseNamePartMap> a rr:TriplesMap ;
  rml:logicalSource <#NameSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue-response/{venueId}/{requestedSeason}/{responseSha256}" ;
    rr:termType rr:IRI
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000178 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/name/mlb-official/{nameLexicalSha256}" ;
      rr:termType rr:IRI
    ]
  ] .

<#HostingFunctionMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/hosting-function" ;
    rr:termType rr:IRI ;
    rr:class base:BaseballGameHostingFunction
  ] .

<#FieldSiteMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field" ;
    rr:termType rr:IRI ;
    rr:class base:BaseballFieldSite
  ] .

<#VenueIdentifierReferenceSystemMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [
    rr:constant <https://baseballontology.org/data/reference-system/mlb-venue-identifiers> ;
    rr:termType rr:IRI ;
    rr:class cco:ont00000398
  ] .

<#DimensionSelectorReferenceSystemMap> a rr:TriplesMap ;
  rml:logicalSource <#VenueSource> ;
  rr:subjectMap [
    rr:constant <https://baseballontology.org/data/reference-system/mlb-venue-dimension-selectors> ;
    rr:termType rr:IRI ;
    rr:class cco:ont00000398
  ] .

<#DimensionResponsePartMap> a rr:TriplesMap ;
  rml:logicalSource <#DimensionSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue-response/{venueId}/{requestedSeason}/{responseSha256}" ;
    rr:termType rr:IRI
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000178 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{selector}/{responseSha256}/selector-id" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000178 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{selector}/{responseSha256}/measurement" ;
      rr:termType rr:IRI
    ]
  ] .

<#FieldDimensionPointPartMap> a rr:TriplesMap ;
  rml:logicalSource <#DimensionSource> ;
  rr:subjectMap [
    rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field" ;
