  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000197 ;
    rr:objectMap [
      rr:template "https://baseballontology.org/data/venue/{venueId}/baseball-field/dimension/{requestedSeason}/{responseSha256}/origin" ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
