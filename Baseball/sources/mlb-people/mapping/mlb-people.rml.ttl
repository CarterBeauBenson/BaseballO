<#PersonMap> a rr:TriplesMap ;
  rml:logicalSource <#RecordSource> ;
  rr:subjectMap [
    rml:reference "personIri" ;
    rr:termType rr:IRI ;
    rr:class cco:ont00001262
  ] .
<#ResponseMap> a rr:TriplesMap ;
  rml:logicalSource <#RecordSource> ;
  rr:subjectMap [
    rml:reference "responseIri" ;
    rr:termType rr:IRI ;
    rr:class cco:ont00000853
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001808 ;
    rr:objectMap [ rml:reference "personIri" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate obo:BFO_0000178 ;
    rr:objectMap [ rml:reference "identifierIri" ; rr:termType rr:IRI ]
  ] .

<#PersonIdentifierMap> a rr:TriplesMap ;
  rml:logicalSource <#RecordSource> ;
  rr:subjectMap [
    rml:reference "identifierIri" ;
    rr:termType rr:IRI ;
    rr:class cco:ont00000649
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001916 ;
    rr:objectMap [ rml:reference "personIri" ; rr:termType rr:IRI ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001912 ;
    rr:objectMap [
      rr:constant <https://baseballontology.org/data/reference-system/mlb-person-id> ;
      rr:termType rr:IRI
    ]
  ] ;
  rr:predicateObjectMap [
    rr:predicate cco:ont00001765 ;
    rr:objectMap [ rml:reference "personId" ; rr:datatype xsd:string ]
  ] .

