@base <https://baseballontology.org/mapping/mlb-people> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix obo: <http://purl.obolibrary.org/obo/> .
@prefix cco: <https://www.commoncoreontologies.org/> .
@prefix base: <https://baseballontology.org/> .

# This mapping consumes only the execution context produced by the module's
# accepted pre-RML gate. The acquired MLB response remains byte-identical and
# transient; the context exists only for the mapping run.

<#RecordSource> a rml:LogicalSource ;
  rml:source "people-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.records[*]" .

<#FullNameSource> a rml:LogicalSource ;
  rml:source "people-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.fullNames[*]" .

<#NicknameSource> a rml:LogicalSource ;
  rml:source "people-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.nicknames[*]" .

<#HeightSource> a rml:LogicalSource ;
  rml:source "people-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.heightMeasurements[*]" .

<#MassSource> a rml:LogicalSource ;
  rml:source "people-context.json" ;
  rml:referenceFormulation ql:JSONPath ;
  rml:iterator "$.massMeasurements[*]" .

<#BattingDispositionSource> a rml:LogicalSource ;
